---
/**
 * "Bought separately" against "in a single plan".
 *
 * The left side is deliberately modest: it adds up only the two pillars that
 * had a published price, and says so. That keeps the comparison checkable. A
 * bigger number built on an estimated "market value" for the other two would
 * be more persuasive and impossible to stand behind.
 */
import TaxMark from '@/src/components/pricing/TaxMark.astro';
import CheckIcon from '@/src/components/pricing/CheckIcon.astro';
import type { CostComparisonProps } from '@/lib/numbers';

export type Props = CostComparisonProps;

const { separateTitle, rows, perMonth, unpricedLabel, totalLabel, total, note, planTitle, planPrice, includedLabel, saving, tax } =
    Astro.props;
---

<div class="grid items-stretch gap-8 lg:grid-cols-[1.15fr_1fr]">
    <div class="rounded-[2.5rem] border-2 border-dashed border-gray-200 bg-white p-8 md:p-10">
        <h3 class="mb-6 text-2xl font-bold text-black">{separateTitle}</h3>
        <ul>
            {
                rows.map((row) => (
                    <li data-testid="ledger-row" class="flex items-baseline justify-between gap-4 border-b border-gray-200 py-3.5 font-semibold text-gray-900">
                        <span>{row.label}</span>
                        {row.value ? (
                            <span class="flex flex-wrap items-baseline justify-end gap-x-2 whitespace-nowrap">
                                <span class="font-bold text-black">{row.value}</span>
                                <span class="text-xs font-bold text-gray-600">{perMonth}</span>
                                <TaxMark label={tax} className="text-gray-700" />
                            </span>
                        ) : (
                            <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-gray-600">{unpricedLabel}</span>
                        )}
                    </li>
                ))
            }
        </ul>
        <p data-testid="ledger-total" class="flex flex-wrap items-baseline justify-between gap-4 pt-5 font-extrabold text-black">
            <span>{totalLabel}</span>
            <span class="flex flex-wrap items-baseline justify-end gap-x-2 whitespace-nowrap">
                <span class="text-3xl tracking-tight">{total}</span>
                <span class="text-xs font-bold text-gray-600">{perMonth}</span>
                <TaxMark label={tax} className="text-gray-700" />
            </span>
        </p>
        <p class="mt-3 text-xs font-medium leading-relaxed text-gray-600">{note}</p>
    </div>

    <div class="force-dark-theme flex flex-col rounded-[2.5rem] border border-blue-500/50 p-8 shadow-[0_0_50px_rgba(59,130,246,0.15)] md:p-10">
        <h3 class="mb-6 text-2xl font-bold text-white">{planTitle}</h3>
        <p data-testid="plan-price" class="flex flex-wrap items-baseline gap-2">
            <span class="text-6xl font-bold tracking-tighter text-white">{planPrice}</span>
            <span class="text-[10px] font-bold uppercase tracking-widest text-gray-300">{perMonth}</span>
            <TaxMark label={tax} className="text-blue-300" />
        </p>
        <p class="mt-5 flex items-center gap-3 font-bold text-white">
            <CheckIcon className="h-5 w-5 text-blue-300" />
            {includedLabel}
        </p>
        <p class="mt-auto border-t border-blue-500/35 pt-6 font-medium leading-relaxed text-gray-200">{saving}</p>
    </div>
</div>
