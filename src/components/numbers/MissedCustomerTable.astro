---
/**
 * "What a customer who never arrives costs": the plan's price set against the
 * value of a customer, for a few example customer values.
 *
 * It is arithmetic, not a forecast. The footnote that says so is not optional
 * decoration: the same figures without it read as outcomes the agency promises.
 * Shared by the home page and the Local SEO page, so the examples and the
 * wording cannot differ between the two.
 */
import type { MissedCustomerTableProps } from '@/lib/numbers';

export type Props = MissedCustomerTableProps;

const { title, description, columns, rows, footnote } = Astro.props;
---

<div>
    <h3 class="mb-3 text-2xl font-bold tracking-tight text-black md:text-3xl">{title}</h3>
    <p class="mb-8 max-w-2xl text-lg font-medium leading-relaxed text-gray-900">{description}</p>

    {/* Wide content scrolls inside its own box on a phone instead of pushing the page sideways. */}
    <div class="overflow-x-auto rounded-[2rem] border border-gray-100 bg-white shadow-[0_20px_60px_rgba(0,0,0,0.05)]">
        <table class="w-full min-w-[34rem] border-collapse text-left">
            <thead>
                <tr>
                    {
                        [columns.value, columns.cover, columns.missed].map((heading) => (
                            <th scope="col" class="w-1/3 px-6 pb-4 pt-6 align-bottom text-[10px] font-black uppercase leading-relaxed tracking-[0.14em] text-gray-600 md:px-8">
                                {heading}
                            </th>
                        ))
                    }
                </tr>
            </thead>
            <tbody>
                {
                    rows.map((row) => (
                        <tr class="border-t border-gray-100">
                            <td class="px-6 py-5 text-xl font-bold tracking-tight text-black md:px-8 md:text-2xl">{row.value}</td>
                            <td class="px-6 py-5 font-bold text-blue-700 md:px-8">{row.cover}</td>
                            <td class="px-6 py-5 text-xl font-bold tracking-tight text-red-700 md:px-8 md:text-2xl">{row.missed}</td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>

    <p data-testid="missed-footnote" class="mt-6 text-center text-xs font-medium italic leading-relaxed text-gray-600">{footnote}</p>
</div>
