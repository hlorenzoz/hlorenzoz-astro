---
/**
 * Hector's digital business card (port of `HectorCardClient.tsx`).
 *
 * The QR code is rendered at BUILD time by qrcode.react through the React
 * renderer, with no `client:*` directive, so it ships as plain SVG and zero JS.
 * The vCard download and the Web NFC writer are the small script below.
 */
import { ArrowRight, Calendar, ChevronRight, CircleAlert, CircleCheck, Download, Globe, Mail, Nfc, Phone, UserPlus } from '@lucide/astro';
import { QRCodeSVG } from 'qrcode.react';
import { getTranslations } from '@/lib/i18n';
import { BASE_URL } from '@/lib/site-config';

export interface Props {
    locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale, 'card.hector');

const profilePhoto = 'https://cdn.hlorenzoz.com/hlorenzoz.com/hector-profile.webp';

/**
 * The URL encoded into the QR code, written to NFC tags, and saved into the
 * vCard.
 *
 * Deliberately the short, locale-less form. It outlives the page: a tag
 * written today is read years from now, and a printed card cannot be
 * reissued, so the URL has to stay short, language-neutral and memorable
 * rather than match the page's canonical exactly. `public/_redirects` sends
 * it to /en/card/hector/, so it costs one hop and lands on a real page.
 *
 * Was `https://www.hlorenzoz.com/card/hector`, wrong twice over: the
 * canonical host carries no `www`, and nothing served that path, so every
 * scan and every tap reached the 404 page.
 */
const cardUrl = `${BASE_URL}/card/hector`;

const socialLinks = [
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/hlorenzoz/', color: 'text-[#0077B5]' },
    { label: 'WhatsApp', href: 'https://wa.me/34643844720', color: 'text-[#25D366]' },
    { label: 'Email', href: 'mailto:hector@hlorenzoz.com', color: 'text-gray-900' },
    { label: 'Phone', href: 'tel:+34643844720', color: 'text-gray-900' },
];

const nfcBase = 'w-full mt-2 py-3 px-4 rounded-xl font-bold text-xs uppercase tracking-widest transition-all flex items-center justify-center gap-2';
const nfcState = {
    idle: { class: `${nfcBase} bg-black text-white hover:bg-gray-800`, text: t('nfcWrite') },
    writing: { class: `${nfcBase} bg-blue-100 text-blue-700 animate-pulse`, text: t('nfcWriting') },
    success: { class: `${nfcBase} bg-green-100 text-green-600`, text: t('nfcSuccess') },
    error: { class: `${nfcBase} bg-red-100 text-red-600`, text: t('nfcError') },
};
---

<div class="min-h-screen bg-[#eff6ff] text-black flex flex-col items-center justify-start pb-12 overflow-x-hidden font-sans" data-hector-card data-card-url={cardUrl}>
    {/* Top Spacing / Safe Area */}
    <div class="h-12 w-full"></div>

    <div class="w-full max-w-[420px] px-6 flex flex-col items-center">
        {/* Profile Header */}
        <div class="flex flex-col items-center text-center mb-8">
            <div class="relative size-28 mb-6">
                <div class="absolute inset-0 bg-blue-500/10 blur-2xl rounded-full"></div>
                <div class="relative size-28 rounded-[2rem] overflow-hidden border-4 border-white shadow-xl">
                    {/* Unresized + fill: the raw CDN URL, lazy. */}
                    <img
                        alt={t('name')}
                        loading="lazy"
                        decoding="async"
                        data-nimg="fill"
                        class="object-cover"
                        style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent"
                        src={profilePhoto}
                    />
                </div>
            </div>
            <h1 class="text-2xl font-black tracking-tight text-gray-900 mb-1">{t('name')}</h1>
            <div class="flex flex-col gap-0.5">
                <p class="text-blue-700 font-extrabold uppercase tracking-widest text-[10px]">{t('title')}</p>
                <p class="text-gray-600 font-bold uppercase tracking-widest text-[10px]">{t('agency')}</p>
            </div>
        </div>

        {/* Primary Action Button */}
        <button
            class="w-full bg-[#1d4ed8] hover:bg-blue-700 text-white flex items-center justify-center gap-3 py-5 rounded-2xl shadow-lg shadow-blue-200 transition-all active:scale-[0.98] mb-4 group"
            data-add-contact
        >
            <UserPlus class="w-6 h-6 group-hover:scale-110 transition-transform" aria-hidden="true" />
            <span class="font-extrabold text-[15px]">{t('addContacts')}</span>
        </button>

        {/* Secondary Action Grid */}
        <div class="grid grid-cols-2 gap-4 w-full mb-12">
            <a
                href={`/${locale}/#contact`}
                class="flex items-center justify-center gap-2 py-5 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-all active:scale-95 group"
            >
                <Calendar class="w-6 h-6 text-blue-700 group-hover:rotate-12 transition-transform" aria-hidden="true" />
                <span class="font-bold text-sm text-gray-900">{t('bookCall')}</span>
            </a>
            <a
                href={BASE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 py-5 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-all active:scale-95 group"
            >
                <Globe class="w-6 h-6 text-blue-700 group-hover:rotate-12 transition-transform" aria-hidden="true" />
                <span class="font-bold text-sm text-gray-900">{t('website')}</span>
            </a>
        </div>

        {/* Get in Touch Section */}
        <div class="w-full flex flex-col items-center mb-12">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-600 mb-8">{t('getInTouch')}</p>
            <div class="flex justify-between w-full px-2 mb-10">
                {
                    socialLinks.map((link) => (
                        <div class="flex flex-col items-center gap-3">
                            <a
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={link.label}
                                class="size-14 rounded-2xl bg-white border border-gray-100 flex items-center justify-center shadow-sm hover:shadow-md hover:scale-110 transition-all active:scale-90 group"
                            >
                                <div class={`${link.color} transition-colors`}>
                                    {link.label === 'LinkedIn' && (
                                        <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                                        </svg>
                                    )}
                                    {link.label === 'WhatsApp' && (
                                        <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.27 9.27 0 01-4.735-1.303l-.339-.202-3.522.924.941-3.434-.221-.353a9.273 9.273 0 01-1.422-4.903c0-5.113 4.158-9.27 9.271-9.27 2.477 0 4.805.964 6.556 2.717a9.204 9.204 0 012.712 6.558c0 5.115-4.158 9.27-9.271 9.27m7.929-18.19A10.929 10.929 0 0012.048 0c-6.071 0-11.012 4.941-11.012 11.011 0 1.943.508 3.84 1.474 5.52L0 24l7.653-2.008a10.887 10.887 0 005.402 1.422H13.04c6.069 0 11.012-4.941 11.012-11.011a10.92 10.92 0 00-3.14-7.783" />
                                        </svg>
                                    )}
                                    {link.label === 'Email' && <Mail class="w-5 h-5" />}
                                    {link.label === 'Phone' && <Phone class="w-5 h-5" />}
                                </div>
                            </a>
                            <span class="text-[10px] font-bold text-gray-600 uppercase tracking-widest" aria-hidden="true">
                                {link.label}
                            </span>
                        </div>
                    ))
                }
            </div>

            {/* QR Code */}
            <div class="p-6 bg-white border border-gray-100 rounded-[2.5rem] shadow-sm flex flex-col items-center gap-4 group w-full">
                <div class="p-4 bg-gray-50 rounded-3xl group-hover:bg-white transition-colors duration-500">
                    <QRCodeSVG value={cardUrl} size={140} level="H" className="group-hover:scale-105 transition-transform duration-500" />
                </div>
                <p class="text-[9px] font-black text-gray-500 uppercase tracking-[0.3em]">{t('agency')}</p>

                {/* NFC Write Button (only shown where Web NFC is supported; the script unhides it) */}
                <button
                    hidden
                    class={nfcState.idle.class}
                    data-nfc
                    data-idle-class={nfcState.idle.class}
                    data-writing-class={nfcState.writing.class}
                    data-success-class={nfcState.success.class}
                    data-error-class={nfcState.error.class}
                    data-idle-text={nfcState.idle.text}
                    data-writing-text={nfcState.writing.text}
                    data-success-text={nfcState.success.text}
                    data-error-text={nfcState.error.text}
                >
                    <CircleCheck class="w-[18px] h-[18px] hidden" aria-hidden="true" data-nfc-icon="success" />
                    <CircleAlert class="w-[18px] h-[18px] hidden" aria-hidden="true" data-nfc-icon="error" />
                    <Nfc class="w-[18px] h-[18px]" aria-hidden="true" data-nfc-icon="default" />
                    <span data-nfc-text>{nfcState.idle.text}</span>
                </button>
            </div>
        </div>

        {/* Map Section */}
        <div class="w-full bg-white rounded-3xl p-4 shadow-sm border border-gray-50 mb-12">
            <div class="relative w-full rounded-2xl overflow-hidden h-[200px] mb-4 group">
                <iframe
                    title={t('location')}
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d11847.658948928492!2d-7.736032078970972!3d42.066446919111925!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd3ab3918c74b993%3A0x3f06524989fbc8bd!2sXinzo%20de%20Limia%2C%2032630%20Xinzo%20de%20Limia%2C%20Province%20of%20Ourense!5e0!3m2!1sen!2ses!4v1772094743627!5m2!1sen!2ses"
                    width="100%"
                    height="100%"
                    style="border:0"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="bg-gray-100"></iframe>
                {/* Location Overlay Chip */}
                <div class="absolute top-4 left-4 inline-flex items-center gap-2 px-4 py-2 bg-white rounded-full shadow-lg border border-gray-100 transition-transform group-hover:scale-105">
                    <div class="size-4 bg-red-600 rounded-full flex items-center justify-center">
                        <div class="size-1.5 bg-white rounded-full"></div>
                    </div>
                    <span class="text-xs font-bold text-gray-900">{t('location')}</span>
                </div>
            </div>
            <a href="https://maps.app.goo.gl/TfnWh83Z4e8yDFs58" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between group py-2">
                <span class="text-sm font-bold text-gray-900 tracking-tight group-hover:text-black transition-colors">{t('viewMaps')}</span>
                <ArrowRight class="w-6 h-6 text-gray-500 group-hover:translate-x-1 group-hover:text-black transition-all" aria-hidden="true" />
            </a>
        </div>

        {/* Install App Section */}
        <div class="w-full bg-[#0f172a] rounded-3xl p-6 shadow-2xl flex items-center justify-between group hover:bg-[#1e293b] transition-colors cursor-pointer mb-8">
            <div class="flex items-center gap-5">
                <div class="size-12 rounded-2xl bg-white/10 flex items-center justify-center group-hover:scale-110 transition-transform">
                    <Download class="w-6 h-6 text-white" aria-hidden="true" />
                </div>
                <div class="flex flex-col">
                    <p class="text-white font-black text-lg tracking-tight uppercase leading-none mb-1">{t('installApp')}</p>
                    <p class="text-gray-400 font-bold text-[10px] uppercase tracking-widest" aria-hidden="true">{t('addToHome')}</p>
                </div>
            </div>
            <ChevronRight class="w-6 h-6 text-gray-600 group-hover:text-white transition-colors" aria-hidden="true" />
        </div>

        {/* Footer Copyright */}
        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-600 mb-8">
            © 2026 {t('agency')}
        </p>
    </div>
</div>

<script>
    type NfcStatus = 'idle' | 'writing' | 'success' | 'error';

    document.querySelectorAll<HTMLElement>('[data-hector-card]').forEach((card) => {
        const cardUrl = card.dataset.cardUrl!;

        card.querySelector('[data-add-contact]')!.addEventListener('click', () => {
            const vcard = `BEGIN:VCARD
VERSION:3.0
FN:Héctor Luis Lorenzo Zaldivar
ORG:Lorenzoz Agency
TITLE:Founder & AI Architect
TEL;TYPE=CELL:+34643844720
EMAIL:hector@hlorenzoz.com
URL:${cardUrl}
END:VCARD`;

            const blob = new Blob([vcard], { type: 'text/vcard' });
            const url = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.setAttribute('download', 'hector-lorenzo.vcf');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        const button = card.querySelector<HTMLButtonElement>('[data-nfc]')!;
        if (!('NDEFReader' in window)) return;
        button.hidden = false;

        const setStatus = (status: NfcStatus) => {
            button.className = button.dataset[`${status}Class`]!;
            button.disabled = status === 'writing';
            button.querySelector('[data-nfc-text]')!.textContent = button.dataset[`${status}Text`]!;
            const icon = status === 'success' || status === 'error' ? status : 'default';
            button.querySelectorAll<SVGElement>('[data-nfc-icon]').forEach((svg) => {
                svg.classList.toggle('hidden', svg.dataset.nfcIcon !== icon);
            });
        };

        button.addEventListener('click', async () => {
            try {
                setStatus('writing');
                // @ts-expect-error - NDEFReader is not yet fully typed in standard TS libraries
                const ndef = new window.NDEFReader();
                await ndef.write({ records: [{ recordType: 'url', data: cardUrl }] });
                setStatus('success');
                setTimeout(() => setStatus('idle'), 3000);
            } catch (error) {
                console.error(error);
                setStatus('error');
                setTimeout(() => setStatus('idle'), 3000);
            }
        });
    });
</script>
