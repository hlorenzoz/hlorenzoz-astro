---
/**
 * An optional service: list price struck through, and the price it has when
 * taken alongside the core offer.
 *
 * Both figures are shown on purpose. The discounted one alone would hide that
 * it is conditional, and the list price alone would hide the offer.
 */
import TaxMark from '@/src/components/pricing/TaxMark.astro';
import CheckIcon from '@/src/components/pricing/CheckIcon.astro';

export interface Props {
    title: string;
    subtitle: string;
    /** What the service costs bought on its own. Shown struck through. */
    listPrice: string;
    /** What it costs alongside the core offer. The headline figure. */
    bundlePrice: string;
    listLabel: string;
    bundleLabel: string;
    /**
     * Set only when the price is a floor ("from 14000"). Omitted, the figure is
     * exact; a floor printed without this word is read as the price.
     */
    fromLabel?: string;
    /** "/ mo" or "one-off payment". */
    terms: string;
    tax: string;
    features: string[];
    ctaLabel: string;
    ctaHref: string;
    learnMoreLabel: string;
    learnMoreHref: string;
}

const {
    title,
    subtitle,
    listPrice,
    bundlePrice,
    listLabel,
    bundleLabel,
    fromLabel,
    terms,
    tax,
    features,
    ctaLabel,
    ctaHref,
    learnMoreLabel,
    learnMoreHref,
} = Astro.props;
---

<div class="force-light-theme flex flex-col gap-6 rounded-[3.5rem] border border-gray-100 p-10 text-left shadow-2xl">
    <div>
        <h3 class="mb-1 text-xl font-black uppercase tracking-tight text-black">{title}</h3>
        <p class="text-[11px] font-black uppercase tracking-[0.2em] text-gray-900">{subtitle}</p>
    </div>

    <div>
        <p class="flex items-baseline gap-2">
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-600">{listLabel}</span>
            <s data-testid="addon-list-price" class="text-lg font-bold text-gray-500">{listPrice}</s>
        </p>
        <p class="mt-3 text-[10px] font-black uppercase tracking-[0.2em] text-blue-700">{bundleLabel}</p>
        {
            fromLabel && (
                <p data-testid="addon-from" class="text-sm font-bold text-gray-700">
                    {fromLabel}
                </p>
            )
        }
        <p data-testid="addon-bundle-price" class="whitespace-nowrap text-5xl font-bold tracking-tighter text-black">{bundlePrice}</p>
        <p data-testid="addon-terms" class="mt-2 flex flex-wrap items-baseline gap-2">
            <span class="text-[10px] font-bold uppercase tracking-widest text-gray-600">{terms}</span>
            <TaxMark label={tax} className="text-blue-700" />
        </p>
    </div>

    <ul class="flex-1 space-y-4">
        {
            features.map((feature) => (
                <li class="flex items-start gap-4 text-sm font-semibold text-black">
                    <CheckIcon className="h-5 w-5 text-blue-700" />
                    <span>{feature}</span>
                </li>
            ))
        }
    </ul>

    <a href={ctaHref} class="w-full rounded-2xl bg-black py-5 text-center text-[11px] font-black uppercase tracking-[0.2em] text-white shadow-xl shadow-black/10">{ctaLabel}</a>
    <a href={learnMoreHref} data-testid="pricing-learn-more" class="w-full text-center text-[11px] font-black uppercase tracking-[0.2em] text-gray-900 hover:text-black">
        {learnMoreLabel} <span class="sr-only">{title}</span>
    </a>
</div>
