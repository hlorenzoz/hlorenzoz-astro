---
/**
 * The one core offer, as a wide card: price and call to action on the left,
 * what is included on the right.
 *
 * It replaces the middle tier of the old three-column pricing grid. That grid
 * said "three services, pick one"; the model now is one plan with everything in
 * it, so the card is the only one of its kind and spans the row.
 */
import TaxMark from '@/src/components/pricing/TaxMark.astro';
import CheckIcon from '@/src/components/pricing/CheckIcon.astro';

export interface Props {
    popular: string;
    title: string;
    subtitle: string;
    /** Already formatted for the locale, from `PRICING`. Never a literal. */
    price: string;
    period: string;
    tax: string;
    /** What the plan works toward. A goal, never a guarantee. */
    goal: string;
    ctaLabel: string;
    ctaHref: string;
    learnMoreLabel: string;
    learnMoreHref: string;
    /** One group per pillar of the plan. */
    groups: { label: string; items: string[] }[];
}

const { popular, title, subtitle, price, period, tax, goal, ctaLabel, ctaHref, learnMoreLabel, learnMoreHref, groups } =
    Astro.props;

// The outline is a `ring`, not just the border. `force-dark-theme` pins
// `border-color` to a half-transparent blue with `!important`, so a brighter
// border class has no effect and the card nearly vanished against the black
// section. A ring is a box-shadow: that rule cannot dim it. The glow is passed
// through `--tw-shadow`-compatible utilities so the two compose instead of one
// replacing the other.
---

<div
    data-testid="core-plan-card"
    class="force-dark-theme relative mx-auto mt-16 grid max-w-5xl gap-10 rounded-[3.5rem] border-2 p-10 text-left ring-2 ring-blue-500 shadow-[0_0_90px_rgba(59,130,246,0.45)] md:p-12 lg:grid-cols-[1fr_1.25fr] lg:gap-12"
>
    <div class="absolute -top-4 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-blue-700 px-6 py-2 text-[11px] font-black uppercase tracking-widest text-white shadow-xl shadow-blue-700/30">
        {popular}
    </div>

    <div>
        <h3 class="mb-1 text-2xl font-black uppercase tracking-tight text-white">{title}</h3>
        <p class="mb-8 text-[11px] font-black uppercase tracking-[0.2em] text-blue-300">{subtitle}</p>

        <p data-testid="core-plan-price" class="flex flex-wrap items-baseline gap-2">
            <span class="text-6xl font-bold tracking-tighter text-white md:text-7xl">{price}</span>
            <span class="text-[10px] font-bold uppercase tracking-widest text-gray-300">{period}</span>
            <TaxMark label={tax} className="text-blue-300" />
        </p>

        <p class="my-8 rounded-2xl border border-blue-700/30 bg-blue-700/10 p-4 text-[11px] font-black uppercase leading-relaxed tracking-widest text-blue-100">
            {goal}
        </p>

        <a href={ctaHref} class="block w-full rounded-2xl bg-blue-800 py-5 text-center text-[11px] font-black uppercase tracking-[0.2em] text-white shadow-xl shadow-blue-800/20 hover:bg-black">{ctaLabel}</a>
        {/* The visible label stays short; the sr-only span carries the offer
            name, so the link reads "Learn more Local SEO" to a screen reader
            and a crawler. No `aria-label`: it would override this text and let
            the two drift apart. */}
        <a href={learnMoreHref} data-testid="pricing-learn-more" class="mt-5 block w-full text-center text-[11px] font-black uppercase tracking-[0.2em] text-blue-300 hover:text-white">
            {learnMoreLabel} <span class="sr-only">{title}</span>
        </a>
    </div>

    <div class="grid content-start gap-x-10 gap-y-8 sm:grid-cols-2">
        {
            groups.map((group) => (
                <div>
                    <p class="mb-4 border-b border-blue-700/30 pb-3 text-[10px] font-black uppercase tracking-[0.25em] text-blue-300">{group.label}</p>
                    <ul class="space-y-3">
                        {group.items.map((item) => (
                            <li class="flex items-start gap-3 text-sm font-bold text-gray-100">
                                <CheckIcon className="mt-0.5 h-4 w-4 text-blue-300" />
                                <span>{item}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
</div>
