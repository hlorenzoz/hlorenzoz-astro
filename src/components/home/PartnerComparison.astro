---
/** Buying services against working with a partner, side by side. Strings in. */
import { Check, CircleCheckBig, CircleX } from '@lucide/astro';

interface Column {
    title: string;
    items: string[];
}

export interface Props {
    badge: string;
    title: string;
    services: Column;
    partner: Column;
}

const { badge, title, services, partner } = Astro.props;
---

<section id="partner" class="py-24 px-6 bg-[#fafafa]">
    <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
            <p class="text-blue-800 font-extrabold tracking-[0.2em] uppercase text-[12px] mb-6">{badge}</p>
            <h2 class="text-4xl md:text-6xl font-bold text-black tracking-tight leading-tight">{title}</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
            <div class="p-10 rounded-[2.5rem] border-2 border-dashed border-gray-200 bg-gray-50/30">
                <div class="flex items-center gap-3 mb-8">
                    <CircleX class="w-8 h-8 text-red-600/60" aria-hidden="true" />
                    <h3 class="text-2xl font-bold text-gray-900">{services.title}</h3>
                </div>
                <ul class="space-y-5">
                    {
                        services.items.map((item) => (
                            <li class="flex items-start gap-4 text-gray-900 font-medium">
                                <CircleX class="w-5 h-5 text-red-600 shrink-0 mt-1" aria-hidden="true" />
                                <span>{item}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
            <div class="p-10 rounded-[2.5rem] border-2 border-blue-500/20 bg-blue-50/10 shadow-lg shadow-blue-500/5">
                <div class="flex items-center gap-3 mb-8">
                    <CircleCheckBig class="w-8 h-8 text-blue-700" aria-hidden="true" />
                    <h3 class="text-2xl font-bold text-black">{partner.title}</h3>
                </div>
                <ul class="space-y-5">
                    {
                        partner.items.map((item) => (
                            <li class="flex items-start gap-4 text-black font-bold">
                                <Check class="w-5 h-5 text-blue-700 shrink-0 mt-1" aria-hidden="true" />
                                <span>{item}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
