---
/**
 * The services as building blocks of one solution, each card a link to its
 * own page. Strings and hrefs in; the card title is the link's accessible name.
 */
import { ArrowRight } from '@lucide/astro';

export interface Props {
    badge: string;
    title: string;
    subtitle: string;
    cta: string;
    items: { title: string; description: string; href: string }[];
}

const { badge, title, subtitle, cta, items } = Astro.props;
---

<section id="solutions" class="py-32 px-6 bg-[#f9f9f9]">
    <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl mb-16">
            <p class="text-blue-800 font-extrabold tracking-[0.2em] uppercase text-[12px] mb-6">{badge}</p>
            <h2 class="text-4xl md:text-6xl font-bold text-black mb-8 tracking-tight leading-tight">{title}</h2>
            <p class="text-lg md:text-xl text-black font-medium leading-relaxed">{subtitle}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                items.map((item) => (
                    <a
                        href={item.href}
                        class="bg-white p-9 rounded-[3rem] border border-gray-100 shadow-[0_20px_60px_rgba(0,0,0,0.05)] flex flex-col gap-4 hover:border-blue-200 transition-colors"
                    >
                        <h3 class="text-xl font-bold text-black tracking-tight leading-tight">{item.title}</h3>
                        <p class="text-gray-900 leading-relaxed font-medium text-sm grow">{item.description}</p>
                        <span class="text-blue-800 font-extrabold uppercase text-xs tracking-[0.2em] flex items-center gap-2">
                            {cta} <ArrowRight class="w-4 h-4" aria-hidden="true" />
                        </span>
                    </a>
                ))
            }
        </div>
    </div>
</section>
