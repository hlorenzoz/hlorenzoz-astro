---
/** The numbered steps from the free analysis to measured results. Strings in. */
export interface Props {
    badge: string;
    title: string;
    steps: { title: string; description: string }[];
    note: string;
}

const { badge, title, steps, note } = Astro.props;
---

<section id="how" class="py-32 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-20 max-w-3xl mx-auto">
            <p class="text-blue-800 font-extrabold tracking-[0.2em] uppercase text-[12px] mb-6">{badge}</p>
            <h2 class="text-4xl md:text-6xl font-bold text-black tracking-tight leading-tight">{title}</h2>
        </div>
        <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                steps.map((step, i) => (
                    <li class="bg-white p-8 rounded-[2rem] border border-gray-100 shadow-[0_20px_60px_rgba(0,0,0,0.05)] flex flex-col gap-3">
                        <span class="text-sm font-black text-blue-800" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        <h3 class="text-xl font-bold text-black tracking-tight">{step.title}</h3>
                        <p class="text-gray-900 font-medium leading-relaxed text-sm">{step.description}</p>
                    </li>
                ))
            }
        </ol>
        <p class="mt-12 text-center text-base font-bold text-black">{note}</p>
    </div>
</section>
