---
/**
 * Mounts the ElevenLabs React island
 * once the visitor scrolls past half the viewport (an engagement signal). React
 * is only downloaded at that point, through the dynamic import below.
 *
 * A click on any `[data-assistant-open]` button (the AI Voice Receptionist
 * page's "Start a conversation") is an explicit request: it mounts the island
 * at once, expands it if it is shrunk and focuses its start button. The
 * microphone is only asked for when the visitor presses that button.
 *
 * After load it first asks whether the agent can answer at all
 * (`assistant-availability.ts`): when the ElevenLabs account has no quota the
 * assistant is never mounted and a WhatsApp button takes its place, and the
 * "Start a conversation" buttons open WhatsApp. The answer is kept for an hour.
 */
import { getTranslations } from '@/lib/i18n';
import { ORGANIZATION } from '@/lib/site-config';

export interface Props {
    locale: string;
}

const { locale } = Astro.props;
// The island's text, translated at build time: the island itself loads no messages.
const labels = getTranslations(locale).raw('assistant');
const whatsappNumber = ORGANIZATION.telephone.replace(/\D/g, '');
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(labels.whatsappMessage)}`;
---

<div data-elevenlabs data-locale={locale} data-labels={JSON.stringify(labels)} data-whatsapp={whatsappNumber}></div>

<a
    data-assistant-whatsapp
    hidden
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={labels.whatsapp}
    class="fixed bottom-6 right-6 z-50 flex items-center justify-center rounded-full bg-[#1f7a4d] p-4 text-white shadow-2xl hover:bg-[#19663f] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f7a4d]"
>
    <svg aria-hidden="true" class="size-7" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>

{
    /* Dev only: the island is mounted by a plain script, not a `client:*` directive, so
       Astro never adds @vitejs/plugin-react's Fast Refresh preamble and the dev import
       throws "can't detect preamble". Production builds have no preamble to need. */
    import.meta.env.DEV && (
        <script
            type="module"
            is:inline
            set:html={`import RefreshRuntime from '/@react-refresh';
RefreshRuntime.injectIntoGlobalHook(window);
window.$RefreshReg$ = () => {};
window.$RefreshSig$ = () => (type) => type;
window.__vite_plugin_react_preamble_installed__ = true;`}
        />
    )
}

<script>
    import type { AssistantLabels } from '../islands/ElevenLabsWidget';
    import { hasSavedConversation } from '../islands/conversation-storage';
    import { agentAvailability } from '../islands/assistant-availability';

    const container = document.querySelector<HTMLElement>('[data-elevenlabs]');

    // Skip for bots to ensure clean LCP/Performance scores
    const isBot =
        /Lighthouse|Googlebot|HeadlessChrome|PageSpeed|Chrome-Lighthouse|Pingdom|GTmetrix|bot|spider|crawl/i.test(navigator.userAgent) ||
        navigator.webdriver;

    const whatsapp = document.querySelector<HTMLAnchorElement>('[data-assistant-whatsapp]');
    const storage = (() => {
        try {
            return window.localStorage;
        } catch {
            return null;
        }
    })();
    // Bots never get the assistant, so they never spend a check either: null keeps today's behaviour.
    const availability: Promise<boolean | null> = isBot
        ? Promise.resolve(null)
        : new Promise((resolve) => window.addEventListener('load', () => resolve(agentAvailability(storage, Date.now())), { once: true }));

    if (container) {
        const labels = JSON.parse(container.dataset.labels!) as AssistantLabels;
        let mounted: Promise<void> | undefined;
        const mountAssistant = () =>
            (mounted ??= import('../islands/mount-elevenlabs').then(({ mount }) => mount(container, container.dataset.locale ?? 'en', labels, container.dataset.whatsapp)));

        // The island renders after its own effects run, so poll a few frames for its buttons.
        const openAssistant = (frames = 120) => {
            const buttons = [...container.querySelectorAll('button')];
            buttons.find((b) => b.getAttribute('aria-label') === labels.expand)?.click();
            const start = buttons.find((b) => b.textContent?.trim() === labels.startCall);
            if (start) return start.focus();
            if (frames > 0) requestAnimationFrame(() => openAssistant(frames - 1));
        };

        document.addEventListener('click', (event) => {
            if (!(event.target as Element | null)?.closest?.('[data-assistant-open]')) return;
            // The check has normally finished by the click; window.open still runs within the click's user activation.
            availability.then((available) => {
                if (available === false && whatsapp) window.open(whatsapp.href, '_blank', 'noopener');
                else mountAssistant().then(() => openAssistant());
            });
        });

        availability.then((available) => {
            if (available === false) {
                // No quota: WhatsApp instead of an assistant that cannot answer.
                if (whatsapp) whatsapp.hidden = false;
                return;
            }

            // A conversation in progress on the previous page (a language switch): show it at once.
            if (hasSavedConversation()) mountAssistant();

            if (!isBot) {
                // Mount as soon as the user scrolls below the fold (engagement signal).
                const handleScroll = () => {
                    if (window.scrollY > window.innerHeight * 0.5) {
                        window.removeEventListener('scroll', handleScroll);
                        mountAssistant();
                    }
                };
                window.addEventListener('scroll', handleScroll, { passive: true });
                handleScroll();
            }
        });
    }
</script>
