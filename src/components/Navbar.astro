---
/**
 * Markup is static; the dropdown, the mobile
 * menu, outside click, Escape and the body scroll lock live in the script
 * below. The language switcher is plain links to the same page in each locale
 * it exists in (`lib/routes.ts`), computed at build time.
 */
import { getTranslations } from '@/lib/i18n';
import { localeHref } from '@/lib/routing';
import { findRoute, routeHref } from '@/lib/routes';
import { LOCALES, LOCALE_INFO } from '@/lib/site-config';

interface Props {
    locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale, 'navigation');
const pathname = Astro.url.pathname;

// More robust home page detection
const isHomePage = pathname === '/' || pathname === `/${locale}` || pathname === `/${locale}/`;

// Nav keys that resolve to a real route via `localeHref`, not a homepage
// hash. `portfolio` and `services` both have their own pages; every other
// key is a homepage section anchor.
const ROUTE_KEYS: Record<string, string> = {
    portfolio: 'portfolio',
    services: 'services',
};

const getHref = (key: string) => {
    // `localeHref` appends the trailing slash the site canonicalizes on
    // (astro.config.mjs `trailingSlash: 'always'`). A bare `/en/portfolio` is
    // a non-canonical form of a page whose own rel=canonical ends in a slash,
    // and the Navbar ships on every route, so the mismatch was sitewide.
    if (key in ROUTE_KEYS) return routeHref(locale, ROUTE_KEYS[key]);
    const hash = key === 'price' ? 'process' : key;
    return isHomePage ? `#${hash}` : `${routeHref(locale, '')}#${hash}`;
};

const navLinks = ['services', 'portfolio', 'price', 'contact'];

// The registered page this URL is, if any. A path without a locale prefix
// (the 404 page) or an unregistered one has no translated twin, so the
// switcher offers the locale homes instead.
const segments = pathname.split('/');
const pagePath = (LOCALES as readonly string[]).includes(segments[1]) ? segments.slice(2).join('/').replace(/\/+$/, '') : undefined;
const page = pagePath === undefined ? undefined : findRoute(pagePath);
const switchPath = page ? page.path : '';
// Only the locales this page exists in: a link to an unbuilt translation is a 404.
const langs = (page ?? findRoute(''))?.locales ?? [];
const switchHref = (newLocale: string) => localeHref(newLocale, switchPath);

const contactHref = isHomePage ? "#contact" : `${routeHref(locale, '')}#contact`;
// Starts with the visible locale code so the accessible name contains the visible label (WCAG 2.5.3).
const langMenuLabel = t('languageMenu', { code: locale.toUpperCase() });
const langMenuCloseLabel = t('languageMenuClose', { code: locale.toUpperCase() });
---

<nav class="fixed top-0 left-0 right-0 z-[100] px-2 sm:px-6 py-4 sm:py-6">
    <div class="bg-white/95 mx-auto max-w-6xl w-full rounded-full px-3 sm:px-6 py-2.5 flex items-center justify-between shadow-2xl shadow-black/5 gap-2 sm:gap-4 border border-white/20">
        {/* Logo */}
        <a href={routeHref(locale, '')} class="flex items-center gap-2 group flex-shrink-0" aria-label={t('homeLabel')} data-nav-logo>
            <div class="size-8 rounded-full bg-black flex items-center justify-center text-white shadow-lg shadow-black/10 flex-shrink-0">
                <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M7 18h2V6H7v12zm4 4h2V2h-2v20zm-8-8h2v-4H3v4zm12 4h2V6h-2v12zm4-8v4h2v-4h-2z"></path>
                </svg>
            </div>
            <span class="text-black text-base font-black tracking-tighter uppercase whitespace-nowrap">Lorenzoz<span class="hidden sm:inline min-[380px]:inline"> Agency</span></span>
        </a>

        {/* Desktop Links */}
        <div class="hidden xl:flex items-center gap-10">
            {
                navLinks.map((key) => (
                    <a href={getHref(key)} class="text-[11px] font-black uppercase tracking-[0.15em] text-gray-900">
                        {t(key)}
                    </a>
                ))
            }
        </div>

        {/* CTA & Language */}
        <div class="flex items-center gap-1 sm:gap-2">
            <div class="relative" data-lang-switcher>
                <button
                    data-testid="language-switcher"
                    aria-label={langMenuLabel}
                    data-label-open={langMenuLabel}
                    data-label-close={langMenuCloseLabel}
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    class="flex items-center gap-1 sm:gap-2 text-[11px] font-black uppercase tracking-[0.1em] text-gray-900 px-2 sm:px-3 py-2 rounded-full cursor-pointer"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 6 6"></path><path d="m4 14 6-6 2-3"></path><path d="M2 5h12"></path><path d="M7 2h1"></path><path d="m22 22-5-10-5 10"></path><path d="M14 18h6"></path></svg>
                    <span>{locale}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class=""><path d="m6 9 6 6 6-6"></path></svg>
                </button>
                <div class="absolute right-0 mt-2 w-32 bg-white rounded-2xl overflow-hidden shadow-2xl border border-gray-100 z-[60] hidden">
                    <div class="flex flex-col py-1">
                        {
                            langs.map((loc) => (
                                <a
                                    href={switchHref(loc)}
                                    data-testid={`lang-option-${loc}`}
                                    class={`px-4 py-2 text-[11px] font-black uppercase tracking-widest flex items-center justify-between w-full cursor-pointer ${locale === loc ? 'text-blue-700' : 'text-gray-900'}`}
                                >
                                    <span>{LOCALE_INFO[loc].name}</span>
                                    <span class="opacity-30">{loc}</span>
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>
            <a href={contactHref} class="hidden sm:block bg-blue-900 text-white text-[11px] font-black uppercase tracking-[0.15em] px-6 py-3 rounded-full shadow-xl shadow-blue-500/20">
                {t('bookConsultation')}
            </a>
            <button class="xl:hidden p-2 text-black" aria-label={t('openMenu')} data-label-open={t('openMenu')} data-label-close={t('closeMenu')} aria-expanded="false" data-testid="mobile-menu-toggle">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
            </button>
        </div>
    </div>
</nav>

{/* Mobile Menu Overlay */}
<div class="fixed inset-0 z-[90] xl:hidden overflow-hidden hidden" data-mobile-menu>
    {/* Backdrop */}
    <div class="absolute inset-0 bg-black/60 backdrop-blur-md" data-mobile-menu-backdrop></div>

    {/* Menu Content */}
    <div class="absolute right-0 top-0 bottom-0 w-full max-w-sm bg-white shadow-2xl flex flex-col p-10 pt-32 translate-x-full" data-mobile-menu-panel>
        <div class="flex flex-col gap-8">
            <p class="text-[11px] font-black uppercase tracking-[0.3em] text-blue-700 mb-2">{t('menuTitle')}</p>
            {
                navLinks.map((key) => (
                    <a href={getHref(key)} class="text-4xl font-black uppercase tracking-tight text-black hover:text-blue-700" data-mobile-menu-close>
                        {t(key)}
                    </a>
                ))
            }
        </div>

        {/* Mobile Language Switcher */}
        <div class="mt-8 pt-8 border-t border-gray-100">
            <p class="text-[10px] font-bold text-gray-900 uppercase tracking-widest mb-4">{t('languageTitle')}</p>
            <div class="flex gap-4">
                {
                    langs.map((loc) => (
                        <a
                            href={switchHref(loc)}
                            data-testid={`mobile-lang-option-${loc}`}
                            class={`flex-1 text-center py-4 rounded-2xl font-black uppercase text-[10px] tracking-widest ${locale === loc ? 'bg-black text-white shadow-xl shadow-black/10' : 'bg-gray-100 text-gray-900'}`}
                        >
                            {LOCALE_INFO[loc].name}
                        </a>
                    ))
                }
            </div>
        </div>

        <div class="mt-auto pt-10 border-t border-gray-100">
            <a href={contactHref} class="w-full bg-black text-white text-center py-6 rounded-3xl font-black uppercase tracking-widest text-sm shadow-2xl" data-mobile-menu-close>
                {t('bookConsultation')}
            </a>
            <div class="mt-8 flex flex-col gap-2">
                <p class="text-[10px] font-bold text-gray-900 uppercase tracking-widest">{t('connect')}</p>
                <p class="text-sm font-black">contact@hlorenzoz.com</p>
            </div>
        </div>
    </div>
</div>

<script>
    const MENU_ICON =
        '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>';
    const CLOSE_ICON =
        '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>';

    // Language dropdown(s): toggle, outside click, Escape.
    const switchers = Array.from(document.querySelectorAll<HTMLElement>('[data-lang-switcher]')).map((root) => {
        const button = root.querySelector('button')!;
        const menu = button.nextElementSibling as HTMLElement;
        const chevron = button.querySelector('svg:last-of-type') as SVGElement;
        const set = (open: boolean) => {
            button.setAttribute('aria-expanded', String(open));
            button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen)!);
            menu.classList.toggle('block', open);
            menu.classList.toggle('hidden', !open);
            chevron.setAttribute('class', open ? 'rotate-180' : '');
        };
        button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
        // Close when clicking outside
        document.addEventListener('mousedown', (event) => {
            if (!root.contains(event.target as Node)) set(false);
        });
        return set;
    });

    // Mobile menu.
    const toggle = document.querySelector<HTMLButtonElement>('[data-testid="mobile-menu-toggle"]');
    const overlay = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const panel = document.querySelector<HTMLElement>('[data-mobile-menu-panel]');
    const setMenu = (open: boolean) => {
        if (!toggle || !overlay || !panel) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen)!);
        toggle.innerHTML = open ? CLOSE_ICON : MENU_ICON;
        overlay.classList.toggle('block', open);
        overlay.classList.toggle('hidden', !open);
        panel.classList.toggle('translate-x-0', open);
        panel.classList.toggle('translate-x-full', !open);
        // Prevent scroll when menu is open
        document.body.style.overflow = open ? 'hidden' : 'unset';
    };
    setMenu(false);
    toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    document.querySelector('[data-mobile-menu-backdrop]')?.addEventListener('click', () => setMenu(false));
    document.querySelectorAll('[data-mobile-menu-close]').forEach((a) => a.addEventListener('click', () => setMenu(false)));

    document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        setMenu(false);
        switchers.forEach((set) => set(false));
    });

    // On the home page, scroll to top instead of re-navigating to the same route.
    document.querySelector('[data-nav-logo]')?.addEventListener('click', (event) => {
        setMenu(false);
        const { pathname } = window.location;
        // `lang` is the BCP 47 tag (`en-GB`); the URL uses the lowercase code.
        const locale = document.documentElement.lang.toLowerCase();
        if (pathname === '/' || pathname === `/${locale}` || pathname === `/${locale}/`) {
            event.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });
</script>
