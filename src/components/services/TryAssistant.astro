---
/**
 * The AI Voice Receptionist hero card: the site's own assistant as the live
 * demo. The button carries `data-assistant-open`; `ElevenLabsLoader.astro`
 * listens for it, mounts the assistant and focuses its start button.
 */
import { Mic } from '@lucide/astro';

export interface Props {
    id?: string;
    title: string;
    text: string;
    label: string;
    note: string;
}

const { id, title, text, label, note } = Astro.props;
---

<div id={id} class="rounded-[1.75rem] bg-white/5 border border-white/10 p-8 flex flex-col gap-4 scroll-mt-32">
    <div aria-hidden="true" class="size-14 rounded-full bg-blue-500/15 border border-blue-400/30 flex items-center justify-center">
        <Mic class="size-6 text-blue-300" />
    </div>
    <strong class="text-2xl font-extrabold text-white">{title}</strong>
    <p class="text-base leading-relaxed text-gray-300">{text}</p>
    <button type="button" data-assistant-open class="inline-flex items-center justify-center gap-2.5 bg-white text-black text-base font-bold px-6 py-4 rounded-full hover:bg-gray-200">
        <Mic class="size-5" aria-hidden="true" />
        {label}
    </button>
    <p class="text-[13px] text-gray-400">{note}</p>
</div>
