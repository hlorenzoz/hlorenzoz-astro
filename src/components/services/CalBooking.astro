---
/**
 * Cal.com booking embed, shared by the homepage and the service pages, so they
 * all use the one conversion mechanism the site has. Static markup, no JS.
 *
 * `<section aria-labelledby>` rather than a `<div>`: `aria-labelledby` on a
 * roleless div labels nothing, because such a div is not exposed to assistive
 * tech as a region at all, so the heading association was inert.
 */
export interface Props {
    /** Id of an external heading that names this embed, if any. */
    titleId?: string;
}

const { titleId } = Astro.props;
---

<section
    aria-labelledby={titleId}
    class="max-w-5xl w-full mx-auto bg-gray-50 rounded-[4rem] p-1 overflow-hidden shadow-2xl relative border border-gray-100"
>
    <div class="md:p-4 min-h-[700px] relative overflow-hidden">
        <iframe
            src="https://cal.com/hlorenzoz.com/15min?embed=true"
            style="width:100%;height:700px;border:none"
            title="Cal.com Booking"
            loading="lazy"
            class="rounded-[3rem] bg-white shadow-3xl"
        ></iframe>
    </div>
</section>
