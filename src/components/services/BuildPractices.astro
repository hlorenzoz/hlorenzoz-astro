---
/**
 * How we build: a dark section with one glass card per engineering practice
 * (numbered 01, 02...), each a short bulleted list, then a row of figures
 * from this site's own pipeline and a footnote linking to where a visitor can
 * check them. Every string arrives translated through props.
 */
export interface Props {
    id?: string;
    eyebrow?: string;
    title: string;
    subtitle?: string;
    items: { title: string; points: string[] }[];
    figures: { value: string; label: string }[];
    footnote: string;
    link: { label: string; href: string };
}

const { id, eyebrow, title, subtitle, items, figures, footnote, link } = Astro.props;
---

<section id={id} class="py-24 md:py-28 px-6 bg-[#0b0f19] text-white scroll-mt-24">
    <div class="max-w-6xl mx-auto flex flex-col gap-12">
        <div class="flex flex-col gap-3 max-w-3xl">
            {eyebrow && <span class="text-xs font-bold uppercase tracking-[0.18em] text-blue-300">{eyebrow}</span>}
            <h2 class="text-3xl md:text-[2.875rem] font-extrabold tracking-tight leading-[1.1] text-white">{title}</h2>
            {subtitle && <p class="text-lg leading-relaxed text-gray-300">{subtitle}</p>}
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {
                items.map((item, i) => (
                    <div class="rounded-[1.75rem] p-8 flex flex-col gap-4 bg-white/5 border border-white/10 backdrop-blur-md">
                        <span class="text-3xl font-extrabold text-blue-300" aria-hidden="true">
                            {String(i + 1).padStart(2, '0')}
                        </span>
                        <h3 class="text-[1.3rem] font-extrabold tracking-tight text-white">{item.title}</h3>
                        <ul class="flex flex-col gap-2.5">
                            {item.points.map((point) => (
                                <li class="flex gap-3 text-base leading-relaxed text-gray-300">
                                    <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-blue-300" aria-hidden="true" />
                                    <span>{point}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
                figures.map((figure) => (
                    <li class="bg-white text-black rounded-[1.75rem] p-7 flex flex-col gap-2">
                        <span class="text-4xl font-extrabold tracking-tight text-blue-900">{figure.value}</span>
                        <span class="text-sm leading-relaxed text-gray-700">{figure.label}</span>
                    </li>
                ))
            }
        </ul>

        <div class="flex flex-wrap items-center gap-4">
            <p class="text-[13px] text-gray-400">{footnote}</p>
            <a href={link.href} class="text-sm font-bold text-blue-300 underline underline-offset-4 hover:text-blue-200">{link.label}</a>
        </div>
    </div>
</section>
