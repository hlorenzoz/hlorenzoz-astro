---
/**
 * Vertical engagement-process timeline for a service page.
 *
 * Deliberately NOT the homepage's 3-column process grid: the design doc
 * requires >= 4 distinct layout families across the site, so this renders as
 * an ordered list with a connecting rail, a different DOM shape from
 * `BenefitsList`'s two-column grid.
 */
export interface Props {
    title: string;
    steps: { number: string; title: string; description: string }[];
}

const { title, steps } = Astro.props;
---

<section class="py-24 px-6 bg-[#f9f9f9]">
    <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-5xl font-bold text-black mb-16 tracking-tight leading-tight">
            {title}
        </h2>

        <ol class="relative border-l border-gray-200 space-y-12 pl-8">
            {
                steps.map((step) => (
                    <li class="relative">
                        <span class="absolute -left-[2.55rem] flex size-8 items-center justify-center rounded-full bg-blue-900 text-white text-sm font-bold" aria-hidden="true">
                            {step.number}
                        </span>
                        <h3 class="text-xl font-bold text-black mb-2 tracking-tight">{step.title}</h3>
                        <p class="text-gray-900 font-medium leading-relaxed">{step.description}</p>
                    </li>
                ))
            }
        </ol>
    </div>
</section>
