---
/** The agency dossier as a PDF download, just before the booking section. */
export interface Props {
    title: string;
    text: string;
    label: string;
    href: string;
}

const { title, text, label, href } = Astro.props;
---

<section class="py-16 md:py-20 px-6 bg-[#f9f9f9]">
    <div class="max-w-6xl mx-auto bg-white border border-gray-100 rounded-[2rem] p-9 flex flex-wrap items-center justify-between gap-6">
        <div class="flex flex-col gap-1.5 flex-[1_1_420px] min-w-0">
            <h2 class="text-2xl font-extrabold text-black">{title}</h2>
            <p class="text-base text-gray-700">{text}</p>
        </div>
        <a href={href} download class="inline-flex items-center gap-2.5 bg-black text-white text-[15px] font-bold px-7 py-4 rounded-full hover:bg-gray-800">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>
            {label}
        </a>
    </div>
</section>
