---
/** Small labelled tiles under a landing section's text. A tile with `href` turns its text into a link. */
export interface Props {
    items: { title: string; text: string; href?: string }[];
    tone?: 'light' | 'white';
}

const { items, tone = 'light' } = Astro.props;
---

<ul class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-3">
    {
        items.map((item) => (
            <li class={`rounded-[1.25rem] p-[18px] ${tone === 'white' ? 'bg-white border border-gray-100' : 'bg-[#f5f5f7]'}`}>
                <strong class="block text-base text-black">{item.title}</strong>
                {item.href ? (
                    <a href={item.href} class="text-sm font-bold text-blue-700 underline underline-offset-4">
                        {item.text}
                    </a>
                ) : (
                    <span class="text-sm text-gray-700">{item.text}</span>
                )}
            </li>
        ))
    }
</ul>
