---
/**
 * The server renders the initial
 * state (slide 0 active, "previous" disabled); the script below keeps the
 * pagination dots and arrow buttons in step with the scroll position, and maps
 * the ArrowLeft / ArrowRight keys to one slide.
 */
import { ArrowRight, ChevronLeft, ChevronRight, ExternalLink, Eye, Globe, PanelsTopLeft } from '@lucide/astro';
import FadeInImage from '@/src/components/FadeInImage.astro';
import type { PortfolioItem } from '@/lib/portfolio';
import { portfolioTypeBadgeClass } from '@/lib/portfolio-theme';
import { getTranslations } from '@/lib/i18n';
import { localeHref } from '@/lib/routing';
import { routeHref } from '@/lib/routes';

export interface Props {
    portfolioItems: PortfolioItem[];
    /** Defaults to the route's `[locale]` param, as `useParams()` did. */
    locale?: string;
}

const { portfolioItems } = Astro.props;
const locale = Astro.props.locale || Astro.params.locale || 'en';
const t = getTranslations(locale, 'portfolio.portfolioCarousel');
const tt = getTranslations(locale, 'portfolio');
---

<section id="portfolio" class="py-24 px-6 bg-white overflow-hidden" data-carousel>
    <div class="max-w-7xl mx-auto mb-16 px-4">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
            <div>
                <h2 class="text-4xl md:text-6xl font-bold text-black mb-6 tracking-tight">
                    {t('title')}
                </h2>
                <p class="text-xl text-gray-900 max-w-2xl font-medium leading-relaxed">
                    {t('subtitle')}
                </p>
            </div>
            <a href={routeHref(locale, 'portfolio')} class="inline-flex items-center gap-2 text-blue-700 font-bold hover:text-blue-700 group">
                {t('cta')}
                <ArrowRight class="w-5 h-5" aria-hidden="true" />
            </a>
        </div>
    </div>

    <div class="relative group/scroll-container max-w-7xl mx-auto">
        <div
            data-carousel-track
            class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-px-4 pb-6 px-4 cursor-grab active:cursor-grabbing"
            style="scrollbar-width:none;-ms-overflow-style:none"
        >
            {
                portfolioItems.map((item) => (
                    <div class="snap-start shrink-0 w-[80%] sm:w-[45%] lg:w-[31%]">
                        <div class="flex flex-col h-full bg-white rounded-[1.5rem] border border-gray-100 shadow-[0_20px_60px_rgba(0,0,0,0.05)] overflow-hidden">
                            <div class="relative aspect-[16/9] bg-zinc-100 overflow-hidden">
                                <FadeInImage
                                    src={item.image}
                                    alt={tt(`${item.id}.title`)}
                                    fill
                                    sizes="(max-width: 640px) 80vw, (max-width: 1024px) 45vw, 400px"
                                    priority={false}
                                    className="object-cover"
                                />
                            </div>
                            <div class="flex flex-col flex-1 gap-3 p-5">
                                <div class="flex flex-wrap gap-2">
                                    <span class="inline-block px-2 py-0.5 rounded-full bg-blue-900 text-white text-[11px] font-bold tracking-widest uppercase border border-blue-900">
                                        {tt(`${item.id}.badge`)}
                                    </span>
                                    <span class={portfolioTypeBadgeClass(item.type, 'sm')}>
                                        {item.type === 'live' ? <Globe class="w-3 h-3" aria-hidden="true" /> : <PanelsTopLeft class="w-3 h-3" aria-hidden="true" />}
                                        {tt(`type.${item.type}`)}
                                    </span>
                                </div>
                                <h3 class="text-lg font-bold text-black tracking-tight leading-tight"><a href={localeHref(locale, `portfolio/${item.slug}`)}>{tt(`${item.id}.title`)}</a></h3>
                                <p class="text-sm text-gray-900 line-clamp-2">{tt(`${item.id}.description`)}</p>
                                <div class="flex gap-3 mt-auto pt-2">
                                    <a
                                        href={localeHref(locale, `portfolio/${item.slug}`)}
                                        class="flex-1 px-4 py-3 rounded-2xl bg-black text-white font-bold text-sm flex items-center justify-center gap-2"
                                    >
                                        <Eye class="w-4 h-4" aria-hidden="true" />
                                        {t('explore')}
                                    </a>
                                    <a
                                        href={item.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex-1 px-4 py-3 rounded-2xl bg-white border border-gray-200 text-black font-bold text-sm flex items-center justify-center gap-2"
                                    >
                                        <ExternalLink class="w-4 h-4" aria-hidden="true" />
                                        {item.type === 'live' ? t('viewLive') : t('liveDemo')}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        {/* Desktop Side Navigation Buttons */}
        {
            portfolioItems.length > 1 && (
                <>
                    <button
                        data-carousel-prev
                        disabled
                        aria-label={t('prevSlide')}
                        class="absolute left-2 xl:-left-16 top-[22%] -translate-y-1/2 z-10 size-14 rounded-full bg-white/80 backdrop-blur-md border border-gray-100 flex items-center justify-center text-gray-400 shadow-lg group pointer-events-auto"
                    >
                        <ChevronLeft class="w-6 h-6" aria-hidden="true" />
                    </button>
                    <button
                        data-carousel-next
                        aria-label={t('nextSlide')}
                        class="absolute right-2 xl:-right-16 top-[22%] -translate-y-1/2 z-10 size-14 rounded-full bg-white/80 backdrop-blur-md border border-gray-100 flex items-center justify-center text-gray-400 shadow-lg group pointer-events-auto"
                    >
                        <ChevronRight class="w-6 h-6" aria-hidden="true" />
                    </button>
                </>
            )
        }
    </div>

    {/* Pagination Dots */}
    <div class="flex justify-center gap-2 mt-12 pb-4">
        {
            portfolioItems.map((_, i) => (
                <button
                    data-carousel-dot
                    aria-label={t('goToSlide', { index: i + 1 })}
                    aria-current={i === 0 ? 'true' : 'false'}
                    class="group relative size-12 flex items-center justify-center outline-none touch-manipulation"
                >
                    <div class={`rounded-full h-2.5 ${i === 0 ? 'w-10 bg-blue-600' : 'w-2.5 bg-gray-300'}`} />
                </button>
            ))
        }
    </div>
</section>

<script>
    // One scroll listener per carousel for its whole life: rebuilding listeners on
    // every step once dropped scroll events mid-gesture and left the dots stale.
    document.querySelectorAll<HTMLElement>('#portfolio[data-carousel]').forEach((root) => {
        const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
        const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
        const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
        const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
        const slides = Array.from(track.children) as HTMLElement[];
        const count = slides.length;
        let active = 0;
        // scrollLeft that aligns slide i with the track's start (slides are snap-start),
        // clamped to what the track can scroll: near the end several slides share the max.
        // Measured from the real layout, since slide widths differ per breakpoint.
        const maxScroll = () => track.scrollWidth - track.clientWidth;
        const target = (i: number) => {
            const t = track.getBoundingClientRect();
            const s = slides[i].getBoundingClientRect();
            const raw = track.scrollLeft + s.left - t.left - parseFloat(getComputedStyle(track).paddingLeft);
            return Math.max(0, Math.min(maxScroll(), raw));
        };
        const goTo = (i: number) => track.scrollTo({ left: target(Math.max(0, Math.min(count - 1, i))) });
        // Step to the next position the track can actually reach, not just the next index.
        const step = (dir: 1 | -1) => {
            const now = track.scrollLeft;
            const order = dir === 1 ? slides.map((_, i) => i) : slides.map((_, i) => count - 1 - i);
            const i = order.find((j) => (dir === 1 ? target(j) > now + 2 : target(j) < now - 2));
            if (i !== undefined) goTo(i);
        };

        const setActive = (index: number) => {
            if (index === active) return;
            active = index;
            dots.forEach((dot, i) => {
                const on = i === index;
                dot.setAttribute('aria-current', String(on));
                const bar = dot.firstElementChild!;
                bar.classList.toggle('w-10', on);
                bar.classList.toggle('bg-blue-600', on);
                bar.classList.toggle('w-2.5', !on);
                bar.classList.toggle('bg-gray-300', !on);
            });
            if (prev) prev.disabled = index === 0;
            if (next) next.disabled = index === count - 1;
        };

        // Active = the slide whose aligned position is closest to the scroll offset;
        // at the end of the track, the last slide (the ones after it cannot align).
        track.addEventListener(
            'scroll',
            () => {
                if (track.scrollLeft >= maxScroll() - 2) return setActive(count - 1);
                let best = 0;
                slides.forEach((_, i) => {
                    if (Math.abs(target(i) - track.scrollLeft) < Math.abs(target(best) - track.scrollLeft)) best = i;
                });
                setActive(best);
            },
            { passive: true }
        );

        prev?.addEventListener('click', () => step(-1));
        next?.addEventListener('click', () => step(1));
        dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
        window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft' && active > 0) step(-1);
            if (e.key === 'ArrowRight' && active < count - 1) step(1);
        });
    });
</script>
