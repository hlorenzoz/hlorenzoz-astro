---
/**
 * Sticky table of contents with scroll-spy, plus optional sibling links and a
 * help card. The scroll spy is the script below.
 *
 * Everything is passed in, which is what lets service and supporting-content
 * pages reuse the same navigation as the legal pages without duplicating it.
 */
import { ArrowRight } from '@lucide/astro';
import { localeHref } from '@/lib/routing';

export interface SidebarSection {
    id: string;
    title: string;
}

export interface SidebarLink {
    label: string;
    /** Locale-relative href, e.g. '/privacy-policy'. */
    href: string;
}

export interface SidebarHelpCard {
    title: string;
    content: string;
    cta: string;
    /** Full href including the scheme, e.g. 'mailto:legal@hlorenzoz.com'. */
    href: string;
}

export interface Props {
    locale: string;
    /** Heading above the table of contents. */
    tocLabel: string;
    /** In-page sections. Each id must match a `<section id>` on the page. */
    sections: SidebarSection[];
    /** Sibling pages listed under the TOC. Optional. */
    relatedLinks?: SidebarLink[];
    /** Contact card at the bottom. Optional. */
    helpCard?: SidebarHelpCard;
}

const { locale, tocLabel, sections, relatedLinks, helpCard } = Astro.props;
const pathname = Astro.url.pathname;
---

<aside class="hidden lg:block sticky top-32 h-fit" data-scroll-spy>
    <div class="flex flex-col gap-10">
        {/* Sections TOC */}
        <div>
            <h4 class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 mb-6">
                {tocLabel}
            </h4>
            <ul class="space-y-4">
                {
                    sections.map((section, index) => (
                        <li>
                            <a href={`#${section.id}`} class="group flex items-center gap-4 text-sm font-bold transition-all text-gray-500 hover:text-black">
                                <span class="flex items-center justify-center size-7 rounded-lg text-[10px] border transition-all bg-gray-50 border-gray-100 text-gray-400 group-hover:border-gray-200">
                                    {index + 1}
                                </span>
                                {section.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        {/* Sibling pages */}
        {
            relatedLinks && relatedLinks.length > 0 && (
                <div class="pt-10 border-t border-gray-100">
                    <ul class="space-y-4">
                        {relatedLinks.map((item) => {
                            const isActive = pathname.includes(item.href);
                            return (
                                <li>
                                    <a
                                        href={localeHref(locale, item.href)}
                                        class={`flex items-center gap-3 text-sm font-bold transition-colors ${isActive ? 'text-blue-700' : 'text-gray-500 hover:text-black'}`}
                                    >
                                        <div class={`size-2 rounded-full ${isActive ? 'bg-blue-600 shadow-sm' : 'bg-gray-200'}`} />
                                        {item.label}
                                    </a>
                                </li>
                            );
                        })}
                    </ul>
                </div>
            )
        }

        {/* Help card */}
        {
            helpCard && (
                <div class="relative overflow-hidden p-6 rounded-3xl bg-blue-50/50 border border-blue-100/50 backdrop-blur-sm group">
                    <div class="absolute -top-12 -right-12 size-32 bg-blue-400/10 blur-3xl rounded-full" />
                    <div class="relative z-10">
                        <h5 class="text-sm font-bold text-black mb-2">{helpCard.title}</h5>
                        <p class="text-[12px] text-gray-500 font-medium mb-4 leading-relaxed">{helpCard.content}</p>
                        <a
                            href={helpCard.href}
                            class="inline-flex items-center text-[11px] font-black uppercase tracking-widest text-blue-700 hover:text-blue-700 transition-colors"
                        >
                            {helpCard.cta}
                            <ArrowRight class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
                        </a>
                    </div>
                </div>
            )
        }
    </div>
</aside>

<script>
    const LINK = 'group flex items-center gap-4 text-sm font-bold transition-all';
    const LINK_ON = 'text-blue-700';
    const LINK_OFF = 'text-gray-500 hover:text-black';
    const BADGE = 'flex items-center justify-center size-7 rounded-lg text-[10px] border transition-all';
    const BADGE_ON = 'bg-blue-600 border-blue-600 text-white shadow-lg shadow-blue-200';
    const BADGE_OFF = 'bg-gray-50 border-gray-100 text-gray-400 group-hover:border-gray-200';
    const OFFSET = 200;

    document.querySelectorAll<HTMLElement>('[data-scroll-spy]').forEach((aside) => {
        const links = Array.from(aside.querySelectorAll<HTMLAnchorElement>('ul a[href^="#"]'));
        const ids = links.map((a) => a.hash.slice(1));
        let activeId = '';

        const handleScroll = () => {
            const scrollPosition = window.scrollY + OFFSET;
            const currentSection = ids.find((id) => {
                const element = document.getElementById(id);
                if (!element) return false;
                const { offsetTop, offsetHeight } = element;
                return scrollPosition >= offsetTop && scrollPosition < offsetTop + offsetHeight;
            });
            // Like the hook: keep the last active section until another is entered.
            if (!currentSection || currentSection === activeId) return;
            activeId = currentSection;
            links.forEach((a, i) => {
                const on = ids[i] === activeId;
                a.className = `${LINK} ${on ? LINK_ON : LINK_OFF}`;
                a.firstElementChild!.className = `${BADGE} ${on ? BADGE_ON : BADGE_OFF}`;
            });
        };

        window.addEventListener('scroll', handleScroll);
        handleScroll(); // Initial check
    });
</script>
