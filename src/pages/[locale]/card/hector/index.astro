---
import BaseLayout from '@/src/layouts/BaseLayout.astro';
import JsonLd from '@/src/components/JsonLd.astro';
import HectorCard from '@/src/components/HectorCard.astro';
import { profilePage } from '@/lib/schema';
import type { PageMeta } from '@/lib/page-metadata';
import { absoluteUrl, languageAlternates } from '@/lib/site-config';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'es' } }];
}

const { locale } = Astro.params as { locale: string };

const TITLE = 'Héctor Luis Lorenzo Zaldivar - Digital Business Card';
const DESCRIPTION = 'Founder & AI Architect at Lorenzoz Agency. Connect with me for AI automation and high-end web development.';
const OG_IMAGE = '/hector-og-image.png';
const url = absoluteUrl(locale, 'card/hector');

const meta: PageMeta = {
    title: TITLE,
    description: DESCRIPTION,
    alternates: { canonical: url, languages: languageAlternates('card/hector') },
    openGraph: {
        title: TITLE,
        description: DESCRIPTION,
        url,
        siteName: 'Lorenzoz Agency',
        type: 'profile',
        locale: locale === 'es' ? 'es_ES' : 'en_US',
        images: [{ url: OG_IMAGE, width: 1200, height: 630, alt: 'Héctor Luis Lorenzo Zaldivar - Founder & AI Architect' }],
    },
    twitter: { card: 'summary_large_image', title: TITLE, description: DESCRIPTION, images: [OG_IMAGE] },
};

// The Person entity is provided once globally via the @graph in the layout
// (https://hlorenzoz.com/card/hector/#person) to avoid duplicate nodes.
---

<BaseLayout locale={locale} meta={meta}>
    <JsonLd data={profilePage({ locale })} />
    <HectorCard locale={locale} />
</BaseLayout>
