---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/src/layouts/BaseLayout.astro';
import Navbar from '@/src/components/Navbar.astro';
import Footer from '@/src/components/Footer.astro';
import FadeInImage from '@/src/components/FadeInImage.astro';
import JsonLd from '@/src/components/JsonLd.astro';
import Breadcrumbs from '@/src/components/Breadcrumbs.astro';
import { getTranslations } from '@/lib/i18n';
import { collectionPage } from '@/lib/schema';
import { getNewsItemsAction } from '@/lib/actions/news';
import { latestNewsModified } from '@/lib/news';
import { formatContentDate } from '@/lib/dates';
import { localeInfo } from '@/lib/routing';
import { localeHref } from '@/lib/routing';
import { imageSrcSet } from '@/lib/image';
import type { PageMeta } from '@/lib/page-metadata';
import { OG_IMAGE, absoluteUrl, ogLocale } from '@/lib/site-config';
import { routeAlternates, routeExists, routeLocales } from '@/lib/routes';

export function getStaticPaths() {
    return routeLocales('news').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: string };

const t = getTranslations(locale, 'news');
const tNav = getTranslations(locale, 'navigation');
// Only posts whose page exists in this locale: their copy and link must both resolve.
const items = (await getNewsItemsAction()).filter((item) => routeExists(`news/${item.slug}`, locale));

const url = absoluteUrl(locale, 'news');
const title = `${t('list.title')} | Lorenzoz Agency`;
const description = t('list.subtitle');
const meta: PageMeta = {
    title,
    description,
    alternates: { canonical: url, languages: routeAlternates('news') },
    openGraph: {
        title,
        description,
        url,
        siteName: 'Lorenzoz Agency',
        type: 'website',
        locale: ogLocale(locale),
        images: [{ url: OG_IMAGE, width: 1200, height: 630, alt: title }],
    },
    twitter: { card: 'summary_large_image', title, description, images: [OG_IMAGE] },
};

const crumbs = [
    { name: tNav('home'), url: absoluteUrl(locale) },
    { name: tNav('news'), url: absoluteUrl(locale, 'news') },
];

const structuredData = collectionPage({
    locale,
    name: t('list.title'),
    description: t('list.subtitle'),
    url: absoluteUrl(locale, 'news'),
    dateModified: latestNewsModified(),
    items: items.map((item) => ({
        name: t(`items.${item.id}.title`),
        url: absoluteUrl(locale, `news/${item.slug}`),
    })),
    crumbs,
});

const sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px';
// The first three cards are `priority`, so they are preloaded.
const preloadImages = items.slice(0, 3).map((item) => ({ srcset: imageSrcSet(item.image, { sizes }), sizes }));
---

<BaseLayout locale={locale} meta={meta} preloadImages={preloadImages}>
    <div class="min-h-screen bg-white">
        <JsonLd data={structuredData} />
        <Navbar locale={locale} />

        <main class="pt-32 pb-24">
            <div class="px-6 mb-10">
                <Breadcrumbs crumbs={crumbs} label={tNav('breadcrumb')} className="max-w-7xl mx-auto" />
            </div>

            <section id="news-hero" class="px-6 mb-20 text-center">
                <div class="max-w-4xl mx-auto">
                    <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-black mb-8">{t('list.title')}</h1>
                    <p class="text-xl text-gray-900 max-w-2xl mx-auto font-medium leading-relaxed">{t('list.subtitle')}</p>
                </div>
            </section>

            <section id="news-list" class="px-6">
                <ul role="list" class="max-w-7xl mx-auto grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
                    {
                        items.map((item, i) => {
                            const href = localeHref(locale, `news/${item.slug}`);
                            const title = t(`items.${item.id}.title`);
                            const date = formatContentDate(localeInfo(locale).tag, item.datePublished, 'dayMonthYear');
                            return (
                                <li class="group">
                                    <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-8 shadow-2xl border border-gray-100 bg-zinc-100">
                                        <FadeInImage
                                            src={item.image}
                                            alt=""
                                            fill
                                            priority={i < 3}
                                            sizes={sizes}
                                            className="transition-transform duration-1000 group-hover:scale-110"
                                        />
                                    </div>
                                    <div class="px-4">
                                        <p class="text-[11px] font-bold tracking-widest uppercase text-gray-600 mb-3">
                                            {t('list.published')}{' '}
                                            {date ? <time datetime={date.iso}>{date.text}</time> : item.datePublished}
                                        </p>
                                        <h2 class="text-2xl font-bold text-black mb-3 group-hover:text-blue-700 transition-colors duration-500">
                                            <a href={href}>{title}</a>
                                        </h2>
                                        <p class="text-gray-900 mb-6 line-clamp-3 font-medium leading-relaxed">
                                            {t(`items.${item.id}.description`)}
                                        </p>
                                        <a href={href} class="inline-flex items-center gap-2 text-black font-bold">
                                            {t('list.cta')}
                                            <span class="sr-only">: {title}</span>
                                            <ArrowRight class="w-4 h-4" aria-hidden="true" />
                                        </a>
                                    </div>
                                </li>
                            );
                        })
                    }
                </ul>
            </section>
        </main>

        <Footer locale={locale} />
    </div>
</BaseLayout>
