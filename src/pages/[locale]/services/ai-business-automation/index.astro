---
import ServicePage from '../_ServicePage.astro';
import { contentPageFor, serviceContentPagesByKey } from '../_service-content';
import FeatureSection from '@/src/components/services/FeatureSection.astro';
import TileGrid from '@/src/components/services/TileGrid.astro';
import { type Locale } from '@/lib/site-config';
import { routeHref, routeLocales } from '@/lib/routes';
import { getTranslations } from '@/lib/i18n';

export function getStaticPaths() {
    return routeLocales('services/ai-business-automation').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getTranslations(locale, 'landing.aiBusinessAutomation');
const journey: { title: string; text: string }[] = t.raw('journey.steps');
const home = routeHref(locale, '');
---

<ServicePage
    locale={locale}
    namespace="services.aiBusinessAutomation"
    landing="landing.aiBusinessAutomation"
    path="services/ai-business-automation"
    page={contentPageFor(serviceContentPagesByKey.aiBusinessAutomation, locale)}
    hero={{ secondaryLabel: t('hero.secondary'), secondaryHref: '#proof' }}
    benefits={{ eyebrow: t('areas.eyebrow'), subtitle: t('areas.subtitle') }}
>
    <div slot="hero-aside" class="rounded-[2rem] bg-white/5 border border-white/10 p-7 flex flex-col gap-3">
        <strong class="text-xs font-bold uppercase tracking-[0.12em] text-blue-300">{t('journey.title')}</strong>
        <ol class="flex flex-col gap-2.5">
            {
                journey.map((step, i) => (
                    <li class="flex gap-3.5 items-start rounded-[1.125rem] bg-white/5 px-4 py-3.5">
                        <span aria-hidden="true" class="text-[13px] font-extrabold text-blue-300">
                            {String(i + 1).padStart(2, '0')}
                        </span>
                        <span class="text-[15px] leading-snug text-gray-200">
                            <strong class="block text-white">{step.title}</strong>
                            {step.text}
                        </span>
                    </li>
                ))
            }
        </ol>
        <p class="text-xs text-gray-400">{t('journey.note')}</p>
    </div>

    <Fragment slot="after-benefits">
        <FeatureSection id="proof" tone="dark" eyebrow={t('proof.eyebrow')} title={t('proof.title')} paragraphs={[t('proof.text')]}>
            <div class="flex flex-wrap items-center gap-4 mt-2">
                {/* `ElevenLabsLoader.astro` opens the site's assistant on a click on `[data-assistant-open]`. */}
                <button type="button" data-assistant-open class="bg-white text-black text-[15px] font-bold px-6 py-3.5 rounded-full hover:bg-gray-200">
                    {t('proof.button')}
                </button>
                <p class="text-[13px] text-gray-400">{t('proof.note')}</p>
            </div>
            <TileGrid slot="media" tone="dark" items={t.raw('proof.tiles')} />
        </FeatureSection>

        <section class="py-16 md:py-20 px-6 bg-red-50">
            <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-7">
                <div class="flex flex-col gap-2 flex-[1_1_520px] min-w-0">
                    <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight leading-tight text-red-900">{t('costOfWaiting.title')}</h2>
                    <p class="text-[17px] leading-relaxed text-gray-700">{t('costOfWaiting.text')}</p>
                </div>
                <a href={`${home}#cost-of-waiting`} class="bg-red-900 text-white text-base font-bold px-7 py-4 rounded-full hover:bg-red-800">{t('costOfWaiting.cta')}</a>
            </div>
        </section>

        <FeatureSection title={t('fits.title')}>
            <TileGrid tone="white" items={t.raw('fits.tiles')} />
            <div class="rounded-[1.75rem] bg-black text-white p-8 flex flex-wrap items-center justify-between gap-6">
                <div class="flex flex-col gap-2 flex-[1_1_420px] min-w-0">
                    <strong class="text-xl font-extrabold">{t('fits.bigger.title')}</strong>
                    <p class="text-base leading-relaxed text-gray-300">{t('fits.bigger.text')}</p>
                </div>
                <a href={`${home}#how`} class="bg-white text-black text-[15px] font-bold px-6 py-3.5 rounded-full hover:bg-gray-200">{t('fits.bigger.cta')}</a>
            </div>
        </FeatureSection>
    </Fragment>
</ServicePage>
