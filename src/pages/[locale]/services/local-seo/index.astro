---
import ServicePage from '../_ServicePage.astro';
import MissedCustomerTable from '@/src/components/numbers/MissedCustomerTable.astro';
import { missedCustomerTable } from '@/lib/numbers';
import { contentPageFor, serviceContentPagesByKey } from '../_service-content';
import { getTranslations } from '@/lib/i18n';
import { PRICING, priceMessageValues } from '@/lib/pricing';
import { paymentLinkUrl } from '@/lib/payment-links';
import { type Locale } from '@/lib/site-config';
import { routeLocales } from '@/lib/routes';

export function getStaticPaths() {
    return routeLocales('services/local-seo').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const tRoot = getTranslations(locale);
const price = tRoot('services.localSeo.hero.price', { ...priceMessageValues(PRICING.localSeo, locale), tax: tRoot('tax.suffix') });
---

<ServicePage
    locale={locale}
    namespace="services.localSeo"
    path="services/local-seo"
    page={contentPageFor(serviceContentPagesByKey.localSeo, locale)}
    price={price}
    paymentHref={paymentLinkUrl('localSeo')}
>
    {/* The same table the home page shows, built by the same function: what
        the plan costs set against what a customer who never arrives costs. It
        sits right after the price, as the answer to "is it worth it". */}
    <section slot="after-deliverables" id="numbers" class="py-24 px-6 bg-[#fafafa]">
        <div class="max-w-5xl mx-auto">
            <MissedCustomerTable {...missedCustomerTable(locale, tRoot, tRoot('tax.suffix'))} />
        </div>
    </section>
</ServicePage>
