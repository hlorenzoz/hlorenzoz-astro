---
import ServicePage from '../_ServicePage.astro';
import { serviceContentPagesByKey } from '../_service-content';
import { getTranslations } from '@/lib/i18n';
import { PRICING, priceMessageValues } from '@/lib/pricing';
import { paymentLinkUrl } from '@/lib/payment-links';
import { LOCALES, type Locale } from '@/lib/site-config';

export function getStaticPaths() {
    return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const tRoot = getTranslations(locale);
const price = tRoot('services.softwareDevelopment.hero.price', { ...priceMessageValues(PRICING.softwareDevelopment, locale), tax: tRoot('tax.suffix') });
---

<ServicePage
    locale={locale}
    namespace="services.softwareDevelopment"
    path="services/software-development"
    page={serviceContentPagesByKey.softwareDevelopment[locale]}
    price={price}
    paymentHref={paymentLinkUrl('softwareDevelopment')}
></ServicePage>
