---
import ServicePage from '../_ServicePage.astro';
import { contentPageFor, serviceContentPagesByKey } from '../_service-content';
import FeatureSection from '@/src/components/services/FeatureSection.astro';
import BuildPractices from '@/src/components/services/BuildPractices.astro';
import ProofFigure from '@/src/components/services/ProofFigure.astro';
import { PAGESPEED_SCORES, PAGESPEED_URL, PROOF_IMAGES } from '@/src/components/services/proof';
import { type Locale } from '@/lib/site-config';
import { routeExists, routeLocales } from '@/lib/routes';
import { LOCALES, localeHref } from '@/lib/routing';
import { getTranslations } from '@/lib/i18n';
import { getPortfolioItemBySlug } from '@/lib/portfolio';
import { getLinkedInArticles } from '@/lib/linkedin';

export function getStaticPaths() {
    return routeLocales('services/software-development').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getTranslations(locale, 'landing.softwareDevelopment');
const tShared = getTranslations(locale, 'landing.shared');

const investep = getPortfolioItemBySlug('investep-app')!;
const caseStudyPath = `portfolio/${investep.slug}`;
const article = getLinkedInArticles().find((a) => a.id === 'scale-single-codebase-every-device')!;
const platforms: string[] = t.raw('hero.platforms');
const sizes = '(max-width: 1024px) 100vw, 580px';
// The PageSpeed figure and the language count come from the code, so they stay in step with the proof and the site.
const buildFigures = [
    { value: PAGESPEED_SCORES[0]!, label: t('build.figures.pagespeed') },
    { value: t('build.figures.tests.value'), label: t('build.figures.tests.label') },
    { value: t('build.figures.checks.value'), label: t('build.figures.checks.label') },
    { value: String(LOCALES.length), label: t('build.figures.languages') },
];
---

<ServicePage
    locale={locale}
    namespace="services.softwareDevelopment"
    landing="landing.softwareDevelopment"
    path="services/software-development"
    page={contentPageFor(serviceContentPagesByKey.softwareDevelopment, locale)}
    hero={{ secondaryLabel: t('hero.secondary'), secondaryHref: '#case' }}
    benefits={{ eyebrow: t('why.eyebrow') }}
>
    <ul slot="hero" class="mt-2 flex flex-wrap items-center gap-2.5">
        {platforms.map((name) => <li class="px-3.5 py-2 rounded-full bg-white/5 border border-white/15 text-sm font-semibold text-gray-200">{name}</li>)}
        <li class="text-sm text-gray-400">{t('hero.platformsNote')}</li>
    </ul>

    <section slot="after-hero" id="case" class="py-24 md:py-28 px-6 bg-white scroll-mt-24">
        <div class="max-w-6xl mx-auto flex flex-col gap-12">
            <div class="flex flex-wrap items-end justify-between gap-8">
                <div class="flex flex-col gap-5 max-w-3xl">
                    <span class="text-xs font-bold uppercase tracking-[0.18em] text-blue-900">{t('case.eyebrow')}</span>
                    <h2 class="text-3xl md:text-[2.875rem] font-extrabold tracking-tight leading-[1.1] text-black">{t('case.title')}</h2>
                    <p class="text-lg leading-relaxed text-gray-700">{t('case.text')}</p>
                </div>
                <div class="flex flex-wrap items-center gap-4">
                    <a href={investep.url} class="bg-black text-white text-[15px] font-bold px-6 py-3.5 rounded-full hover:bg-gray-800">{t('case.demo')}</a>
                    {
                        routeExists(caseStudyPath, locale) && (
                            <a href={localeHref(locale, caseStudyPath)} class="text-[15px] font-bold text-blue-700 underline underline-offset-4">
                                {tShared('caseStudy')}
                            </a>
                        )
                    }
                </div>
            </div>
            <div class="grid lg:grid-cols-2 gap-6">
                <ProofFigure {...PROOF_IMAGES.investepDark} sizes={sizes} alt={t('case.darkAlt')} caption={t('case.darkCaption')} />
                <ProofFigure {...PROOF_IMAGES.investepLight} sizes={sizes} alt={t('case.lightAlt')} caption={t('case.lightCaption')} />
            </div>
        </div>
    </section>

    <BuildPractices
        slot="after-benefits"
        id="build"
        eyebrow={t('build.eyebrow')}
        title={t('build.title')}
        subtitle={t('build.subtitle')}
        items={t.raw('build.items')}
        figures={buildFigures}
        footnote={t('build.footnote')}
        link={{ label: t('build.linkLabel'), href: PAGESPEED_URL }}
    />

    <FeatureSection
        slot="after-benefits"
        eyebrow={t('article.eyebrow')}
        title={t('article.title')}
        paragraphs={[t('article.text')]}
        link={{ label: t('article.cta'), href: article.url }}
    />
</ServicePage>
