---
import ServicePage from '../_ServicePage.astro';
import { contentPageFor, serviceContentPagesByKey } from '../_service-content';
import { type Locale } from '@/lib/site-config';
import { routeLocales } from '@/lib/routes';

export function getStaticPaths() {
    return routeLocales('services/website-development').map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<ServicePage
    locale={locale}
    namespace="services.websiteDevelopment"
    path="services/website-development"
    page={contentPageFor(serviceContentPagesByKey.websiteDevelopment, locale)}
></ServicePage>
