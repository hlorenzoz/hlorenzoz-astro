---
/**
 * The home page. It passes no `meta`, so the
 * layout's default metadata is the page's metadata.
 */
import { findRoute, routeExists, routeHref, routeLocales } from '@/lib/routes';
import { MousePointerClick, PhoneMissed, Search, Sparkles } from '@lucide/astro';
import BaseLayout from '@/src/layouts/BaseLayout.astro';
import Navbar from '@/src/components/Navbar.astro';
import Footer from '@/src/components/Footer.astro';
import FaqAccordion from '@/src/components/FaqAccordion.astro';
import JsonLd from '@/src/components/JsonLd.astro';
import NewsCarousel from '@/src/components/NewsCarousel.astro';
import PortfolioCarousel from '@/src/components/PortfolioCarousel.astro';
import LinkedInArticles from '@/src/components/LinkedInArticles.astro';
import CalBooking from '@/src/components/services/CalBooking.astro';
import DossierDownload from '@/src/components/services/DossierDownload.astro';
import FactsStrip from '@/src/components/home/FactsStrip.astro';
import PartnerComparison from '@/src/components/home/PartnerComparison.astro';
import HowWeWork from '@/src/components/home/HowWeWork.astro';
import SolutionsGrid from '@/src/components/home/SolutionsGrid.astro';
import BenefitsShowcase from '@/src/components/home/BenefitsShowcase.astro';
import CostOfWaiting from '@/src/components/home/CostOfWaiting.astro';
import FeesModel from '@/src/components/home/FeesModel.astro';
import { getTranslations } from '@/lib/i18n';
import { dossierHref } from '@/lib/dossier';
import { getPortfolioItemsAction } from '@/lib/actions/portfolio';
import { getLinkedInArticlesAction } from '@/lib/actions/linkedin';
import { getNewsItemsAction } from '@/lib/actions/news';
import { serviceList, faqPage, webPage } from '@/lib/schema';
import { SERVICE_DISPLAY_ORDER, SERVICE_KEYS, slugFromServiceKey } from '@/lib/pricing';
import { copyTokens, resolveFaq } from '@/lib/copy-tokens';
import { LOCALES, absoluteUrl, marketNames } from '@/lib/site-config';

export function getStaticPaths() {
    return routeLocales('').map((locale) => ({ params: { locale } }));
}

/** Anyone can rerun the mobile PageSpeed test the facts strip quotes. */
const PAGESPEED_REPORT = 'https://pagespeed.web.dev/analysis?url=https%3A%2F%2Fhlorenzoz.com%2F';

const { locale } = Astro.params as { locale: string };

const t = getTranslations(locale, 'home');
// Root translator: service names and the news copy live outside the `home` namespace.
const tRoot = getTranslations(locale);
// Carousels show only work and posts whose page exists in this locale: their copy and link must both resolve.
const portfolioItems = (await getPortfolioItemsAction()).filter((item) => routeExists(`portfolio/${item.slug}`, locale));
const articles = await getLinkedInArticlesAction();
const news = (await getNewsItemsAction()).filter((item) => routeExists(`news/${item.slug}`, locale));

const tokens = copyTokens();
const faqItems = resolveFaq(t.raw('faq.items'), tokens);

const problemTitle = t.markup('problem.title', {
    trad: (chunks) =>
        `<span class="relative inline-block px-1">${chunks}<span class="absolute inset-x-0 top-[55%] h-[2.5px] bg-red-600 opacity-60"></span></span>`,
    br: () => '<br/>',
});

// One icon per `home.problem.cards` entry, in order.
const PROBLEM_ICONS = [MousePointerClick, Search, Sparkles, PhoneMissed];
---

{/* No image preload: Next emitted one for the Footer's Upwork favicon only because React
    hoists eager <img> tags; a footer icon must not compete with the LCP image. */}
<BaseLayout locale={locale}>
    <div class="min-h-screen bg-white no-animations">
        <Navbar locale={locale} />

        <main>
            {/* Hero Section */}
            <section id="home" class="relative pt-32 pb-20 md:pt-48 md:pb-36 px-6 overflow-hidden hero-bg-deep">
                <div class="max-w-4xl mx-auto text-center flex flex-col items-center gap-8 hero-content relative z-10">
                    {/* Status Badge */}
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-[10px] font-bold tracking-[0.2em] uppercase">
                        <span class="relative flex h-2 w-2">
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                        </span>
                        {t('hero.badge')}
                    </div>

                    <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-white leading-[1.05]">
                        {t('hero.title')} <span class="text-gradient">{t('hero.titleGradient')}</span>
                    </h1>

                    <p class="text-lg md:text-xl text-gray-200 max-w-2xl font-medium leading-relaxed">
                        {t('hero.description')}
                    </p>

                    <div class="flex flex-wrap items-center justify-center gap-6">
                        <a href="#contact" class="bg-blue-900 text-white text-base font-bold px-10 py-4 rounded-full shadow-glow hover:bg-blue-800">
                            {t('hero.cta')}
                        </a>
                        <a href="#how" class="text-blue-200 text-xs font-extrabold uppercase tracking-[0.2em] hover:text-white">
                            {t('hero.secondaryCta')}
                        </a>
                    </div>
                    <p class="text-sm text-gray-300 font-medium">{t('hero.note')}</p>
                </div>
            </section>

            <FactsStrip
                facts={[
                    { value: t('facts.services.value', { count: SERVICE_KEYS.length }), label: t('facts.services.label') },
                    { value: t('facts.languages.value', { count: LOCALES.length }), label: t('facts.languages.label') },
                    { value: t('facts.pageSpeed.value'), label: t('facts.pageSpeed.label'), link: { href: PAGESPEED_REPORT, text: t('facts.pageSpeed.link') } },
                    { value: t('facts.markets.value'), label: t('facts.markets.label') },
                ]}
                marketsTitle={t('markets.title')}
                markets={marketNames(locale)}
            />

            {/* Problem Section */}
            <section id="problem" class="py-24 px-6 bg-white">
                <div class="max-w-6xl mx-auto">
                    <div class="text-center mb-24 px-6">
                        <p class="text-gray-950 font-bold tracking-[0.3em] uppercase text-[12px] mb-8">{t('problem.badge')}</p>
                        <div class="relative inline-block max-w-4xl">
                            <h2 class="text-4xl md:text-6xl font-bold text-black mb-10 tracking-tight leading-tight relative z-10">
                                <Fragment set:html={problemTitle} />
                            </h2>
                        </div>
                        <p class="text-lg md:text-xl text-gray-900 max-w-2xl mx-auto font-medium leading-relaxed mt-4">
                            {t('problem.description')}
                        </p>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        {
                            PROBLEM_ICONS.map((Icon, i) => (
                                <div class="bg-white p-10 rounded-[3rem] flex flex-col gap-8 border border-gray-100 shadow-[0_20px_60px_rgba(0,0,0,0.05)]">
                                    <div class="size-16 rounded-full bg-gray-100 flex items-center justify-center text-black shadow-inner">
                                        <Icon class="w-8 h-8" aria-hidden="true" />
                                    </div>
                                    <div class="flex flex-col gap-4">
                                        <h3 class="text-xl font-bold text-black tracking-tight leading-tight">{t(`problem.cards.${i}.title`)}</h3>
                                        <p class="text-gray-900 leading-relaxed font-medium text-sm">{t(`problem.cards.${i}.description`)}</p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <PartnerComparison
                badge={t('partner.badge')}
                title={t('partner.title')}
                services={{ title: t('partner.services.title'), items: t.raw('partner.services.items') as string[] }}
                partner={{ title: t('partner.partner.title'), items: t.raw('partner.partner.items') as string[] }}
            />

            <HowWeWork
                badge={t('how.badge')}
                title={t('how.title')}
                steps={t.raw('how.steps') as { title: string; description: string }[]}
                note={t('how.note')}
            />

            {/* Every service is a building block of one tailored solution, so each card leads to its own page. */}
            <SolutionsGrid
                badge={t('solutions.badge')}
                title={t('solutions.title')}
                subtitle={t('solutions.subtitle')}
                cta={t('solutions.cta')}
                items={SERVICE_DISPLAY_ORDER.map((key) => ({
                    title: tRoot(`services.${key}.name`),
                    description: t(`solutions.items.${key}`),
                    href: routeHref(locale, `services/${slugFromServiceKey(key)}`),
                }))}
            />

            <PortfolioCarousel portfolioItems={portfolioItems} locale={locale} />

            <BenefitsShowcase locale={locale} />
            <CostOfWaiting locale={locale} />
            <FeesModel locale={locale} />

            <DossierDownload title={t('dossier.title')} text={t('dossier.body')} label={t('dossier.cta')} href={dossierHref(locale)} />

            {/* Final CTA Section */}
            <section id="contact" class="py-32 px-6 bg-white relative overflow-hidden">
                <div class="max-w-6xl mx-auto flex flex-col items-center">
                    <div class="text-center mb-20 max-w-4xl">
                        <h2 id="contact-heading" class="text-4xl md:text-6xl font-bold tracking-tight mb-8 text-black leading-tight">{t('contact.title')}</h2>
                        <p class="text-lg md:text-xl text-gray-900 font-medium leading-relaxed">{t('contact.subtitle')}</p>
                        <p class="mt-4 text-sm font-bold text-gray-700">{t('contact.note')}</p>
                    </div>

                    <CalBooking locale={locale} titleId="contact-heading" />
                </div>
            </section>

            {/* Frequently Asked Questions */}
            <section id="faq" class="py-32 px-6 bg-[#fafafa] border-t border-gray-100">
                <div class="max-w-4xl mx-auto">
                    <h2 class="text-4xl md:text-6xl font-bold text-black mb-20 tracking-tight text-center leading-tight">{t('faq.title')}</h2>
                    <FaqAccordion items={faqItems} />
                </div>
            </section>

            {/* Latest News, directly above the LinkedIn articles */}
            <NewsCarousel
                locale={locale}
                items={news.map((item) => ({
                    slug: item.slug,
                    title: tRoot(`news.items.${item.id}.title`),
                    image: item.image,
                    datePublished: item.datePublished,
                }))}
                eyebrow={tRoot('news.home.eyebrow')}
                title={tRoot('news.home.title')}
                subtitle={tRoot('news.home.subtitle')}
                viewAll={tRoot('news.home.viewAll')}
            />

            {/* Latest LinkedIn Articles */}
            <LinkedInArticles articles={articles} locale={locale} />

            {/* Structured Data for SEO */}
            <JsonLd
                data={webPage({
                    locale,
                    name: t('meta.title'),
                    description: t('meta.description'),
                    url: absoluteUrl(locale),
                    speakable: ['h1', '.hero-content p'],
                    dateModified: findRoute('')?.lastModified,
                })}
            />
            {/* The list names the SERVICES, never the pillars: a pillar is part
                of one service, and emitting four `Service` nodes for them would
                tell a crawler the agency sells them separately. */}
            <JsonLd
                data={serviceList(
                    SERVICE_DISPLAY_ORDER.map((key) => ({
                        title: tRoot(`services.${key}.name`),
                        description: tRoot(`services.${key}.meta.description`),
                    }))
                )}
            />
            <JsonLd data={faqPage(faqItems)} />
        </main>

        <Footer locale={locale} />
    </div>
</BaseLayout>
