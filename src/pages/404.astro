---
import BaseLayout from '@/src/layouts/BaseLayout.astro';
import Navbar from '@/src/components/Navbar.astro';
import Footer from '@/src/components/Footer.astro';
import { localeHref } from '@/lib/routing';
import { getTranslations } from '@/lib/i18n';

const locale = 'en';
const t = getTranslations(locale, 'notFound');

// Not a page to index or to share: drop the home page's canonical, hreflang,
// description, keywords and social cards the layout would otherwise lend it.
const meta = {
    title: t('metaTitle'),
    robots: 'noindex',
    description: undefined,
    keywords: undefined,
    alternates: undefined,
    openGraph: undefined,
    twitter: undefined,
};
---

<BaseLayout locale={locale} meta={meta}>
    <Navbar locale={locale} />
    <section class="min-h-[60vh] flex flex-col items-center justify-center text-center px-6 pt-40 pb-24">
        <p class="text-[11px] font-black uppercase tracking-[0.3em] text-blue-700 mb-4">404</p>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight text-black mb-6">{t('title')}</h1>
        <p class="text-gray-900 font-medium max-w-md mb-10">{t('text')}</p>
        <a href={localeHref(locale, '')} class="bg-black text-white text-[11px] font-black uppercase tracking-[0.15em] px-6 py-3 rounded-full shadow-xl">
            {t('back')}
        </a>
    </section>
    <Footer locale={locale} />
</BaseLayout>
