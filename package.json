{
  "name": "ai-agency-hlorenzoz",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:pages": "astro build",
    "deploy": "bun run build && wrangler deploy",
    "deploy:all": "./scripts/deploy_to_all.sh",
    "preview": "bun run build && wrangler dev",
    "start": "astro preview --port 45723",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "images:sync": "node scripts/convert-and-map.mjs",
    "stripe:sync-payment-links": "node scripts/create-payment-links.mjs",
    "lint": "eslint .",
    "lint:fix": "bun eslint . --fix",
    "type-check": "astro check",
    "test": "sh tests/log.sh vitest vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "sh tests/log.sh vitest_coverage vitest run --reporter=verbose --coverage",
    "test:e2e": "playwright test",
    "test:e2e:static": "playwright test --config playwright.static.config.ts",
    "test:lighthouse": "bun run build && bun x @lhci/cli autorun",
    "test:lighthouse:static": "bun x @lhci/cli autorun --collect.staticDistDir=dist",
    "validate": "bun run lint && bun run type-check && bun run test:coverage",
    "test:all": "bun run build && bun run lint && bun run type-check && bun run test:coverage && bun run test:e2e:static && bun run test:lighthouse:static",
    "test:essentials": "bun run lint:fix && bun run type-check && bun run build && bun run test:lighthouse:static"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@elevenlabs/react": "^0.14.3",
    "@lucide/astro": "0.487.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.5",
    "use-intl": "^4.15.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "30.1.2",
    "prettier": "^3.9.5",
    "sirv-cli": "^3.0.1",
    "stripe": "^22.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "5.0.3",
    "wrangler": "^4.112.0"
  },
  "packageManager": "bun@1.3.6"
}
