# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Cloudflare (Production deployment)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Security
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Database (TBD - uncomment when provider is chosen)
# DATABASE_URL=

# Authentication (TBD - uncomment when provider is chosen)
# AUTH_SECRET=
# AUTH_URL=

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe — used only by scripts/create-payment-links.mjs, never read at
# runtime (static export, no server code). Payment Link URLs are baked into
# the committed lib/payment-links.json at whatever time the script last ran.
# Sandbox: sk_test_... (Stripe Dashboard, sandbox "Lorenzoz Agency")
# Live:    sk_live_...  — only when actually going live
STRIPE_SECRET_KEY=

# Internationalization
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es
