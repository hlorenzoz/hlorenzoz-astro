{
  "ci": {
    "collect": {
      "startServerCommand": "bun sirv dist -p 45723 --single",
      "startServerReadyPattern": "Local:",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://localhost:45723/en/",
        "http://localhost:45723/en/privacy-policy/",
        "http://localhost:45723/en/portfolio/",
        "http://localhost:45723/en/portfolio/lorenzoz-agency/",
        "http://localhost:45723/en/portfolio/dental-clinic-1/",
        "http://localhost:45723/en/news/",
        "http://localhost:45723/en/news/masajes-orisha-portfolio/",
        "http://localhost:45723/en/terms-conditions/",
        "http://localhost:45723/en/cookie-policy/",
        "http://localhost:45723/en/card/hector/",
        "http://localhost:45723/en/sitemap/",
        "http://localhost:45723/en/services/",
        "http://localhost:45723/en/services/website-development/",
        "http://localhost:45723/en/services/local-seo/",
        "http://localhost:45723/en/services/ai-voice-receptionist/",
        "http://localhost:45723/en/services/software-development/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": [
          "--no-sandbox",
          "--disable-dev-shm-usage",
          "--headless",
          "--disable-gpu",
          "--ignore-certificate-errors"
        ],
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 640,
          "deviceScaleFactor": 2,
          "disabled": false
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 3000
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.25
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 4000
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 600
          }
        ],
        "max-potential-fid": [
          "warn",
          {
            "maxNumericValue": 300
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
